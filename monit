local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 6)
    }, obj)
end

local function outline(obj)
    create("UIStroke", {
        Color = Color3.fromRGB(65, 75, 95),
        Thickness = 1
    }, obj)
end

local function json(value)
    local ok, result = pcall(function()
        return HttpService:JSONEncode(value)
    end)

    if ok then
        return result
    end

    return tostring(value)
end

local function serialize(value, depth)
    depth = depth or 0

    if depth > 4 then
        return "<maximum depth>"
    end

    local kind = typeof(value)

    if kind == "nil" or kind == "boolean"
        or kind == "number" or kind == "string" then
        return tostring(value)
    end

    if kind == "Instance" then
        return value:GetFullName()
    end

    if kind == "Vector3" or kind == "Vector2"
        or kind == "CFrame" or kind == "Color3" then
        return tostring(value)
    end

    if kind == "table" then
        local output = {}
        local count = 0

        for k, v in pairs(value) do
            count += 1
            if count > 60 then
                table.insert(output, "... truncated")
                break
            end

            table.insert(output,
                "[" .. serialize(k, depth + 1) .. "] = "
                .. serialize(v, depth + 1)
            )
        end

        return "{\n  " .. table.concat(output, ",\n  ") .. "\n}"
    end

    return tostring(value)
end

-- Monitor API
local Monitor = {}
Monitor.entries = {}
Monitor.maxEntries = 150
Monitor.nextId = 0
Monitor.onChange = nil

function Monitor.log(kind, name, detail)
    Monitor.nextId += 1

    local entry = {
        id = Monitor.nextId,
        time = os.date("%H:%M:%S"),
        kind = tostring(kind or "INFO"),
        name = tostring(name or ""),
        detail = serialize(detail)
    }

    table.insert(Monitor.entries, entry)

    while #Monitor.entries > Monitor.maxEntries do
        table.remove(Monitor.entries, 1)
    end

    if Monitor.onChange then
        pcall(Monitor.onChange, entry)
    end

    return entry
end

function Monitor.wrap(name, fn)
    assert(type(fn) == "function", "Expected a function")

    return function(...)
        local args = table.pack(...)

        Monitor.log("CALL", name, {
            args = args
        })

        local result = table.pack(pcall(function()
            return fn(table.unpack(args, 1, args.n))
        end))

        if not result[1] then
            Monitor.log("ERROR", name, result[2])
            error(result[2], 0)
        end

        local returned = table.pack(
            table.unpack(result, 2, result.n)
        )

        Monitor.log("RETURN", name, {
            values = returned
        })

        return table.unpack(returned, 1, returned.n)
    end
end

