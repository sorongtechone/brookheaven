local function showDetails(entry)
    detailsText.Text = table.concat({
        "ID: " .. entry.id,
        "TIME: " .. entry.time,
        "TYPE: " .. entry.kind,
        "NAME: " .. entry.name,
        "",
        "DETAIL:",
        entry.detail
    }, "\n")

    switchTab("DETAILS")
end

local function rebuildActivity()
    for _, child in ipairs(activityScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    rows = {}

    for _, entry in ipairs(Monitor.entries) do
        local row = create("TextButton", {
            Size = UDim2.new(1, -4, 0, 31),
            BackgroundColor3 = Color3.fromRGB(36, 42, 55),
            Text = string.format(
                "[%s] #%d  %-7s  %s",
                entry.time, entry.id, entry.kind, entry.name
            ),
            TextColor3 = entry.kind == "ERROR"
                and Color3.fromRGB(255, 120, 120)
                or Color3.fromRGB(220, 228, 240),
            TextSize = 11,
            Font = Enum.Font.Code,
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0,
            LayoutOrder = entry.id
        }, activityScroll)

        corner(row, 4)

        row.MouseButton1Click:Connect(function()
            showDetails(entry)
        end)

        table.insert(rows, row)
    end

    countLabel.Text = string.format(
        "Entries: %d/%d",
        #Monitor.entries,
        Monitor.maxEntries
    )
end

Monitor.onChange = function()
    rebuildActivity()
end

clearButton.MouseButton1Click:Connect(function()
    table.clear(Monitor.entries)
    rebuildActivity()
    detailsText.Text = ""
    Monitor.log("INFO", "Monitor", "Activity log cleared")
end)

copyButton.MouseButton1Click:Connect(function()
    local output = {}

    for _, entry in ipairs(Monitor.entries) do
        table.insert(output, string.format(
            "[%s] #%d %s %s\n%s",
            entry.time, entry.id, entry.kind,
            entry.name, entry.detail
        ))
    end

    local textToCopy = table.concat(output, "\n\n")

    local ok = pcall(function()
        if type(setclipboard) ~= "function" then
            error("Clipboard API unavailable")
        end

        setclipboard(textToCopy)
    end)

    Monitor.log("INFO", "Copy", ok
        and "Log copied to clipboard"
        or "Clipboard unavailable in this environment")
end)

