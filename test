-- ===== Helpers =====
local function create(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end

local function corner(o, r)
    create("UICorner", { CornerRadius = UDim.new(0, r or 4) }, o)
end

local function stroke(o, c, t)
    create("UIStroke", { Color = c or Color3.fromRGB(65, 75, 95), Thickness = t or 1 }, o)
end

local function fmtId(v)
    if v == nil then return "N/A" end
    if typeof(v) == "number" and v == 0 then return "0 (tidak diset)" end
    local s = tostring(v)
    if s == "" or s == "0" then return "0 (tidak diset)" end
    return s
end

local function fmtColor(c)
    if typeof(c) ~= "Color3" then return tostring(c) end
    return string.format("#%02X%02X%02X",
        math.floor(c.R * 255 + 0.5),
        math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

