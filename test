-- ===== Scan =====
local function getDescription(player)
    local char = player.Character
    if not char then return nil, "Karakter belum tersedia." end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil, "Humanoid tidak ditemukan." end
    local ok, desc = pcall(function() return hum:GetAppliedDescription() end)
    if ok and desc then return desc end
    return nil, "Gagal membaca HumanoidDescription."
end

local function scanPlayer(player)
    if scanning then return end
    scanning = true
    selectedPlayer = player
    selectedLabel.Text = "Memindai: " .. player.Name
    detailText.Text = "Sedang memindai avatar..."
    detailScroll.CanvasPosition = Vector2.new(0, 0)

    task.spawn(function()
        local L = {}
        local function add(s) L[#L + 1] = tostring(s) end
        local function flush()
            detailText.Text = table.concat(L, "\n")
            task.wait()
        end

        local partCount, meshPartCount, specialMeshCount = 0, 0, 0
        local accessoryCount, layeredCount = 0, 0
        local decalCount, wrapLayerCount, wrapTargetCount = 0, 0, 0
        local errors = 0

        add("========================================")
        add("AVATAR INSPECTOR - HASIL PEMINDAIAN")
        add("========================================")
        add("Player Name : " .. player.Name)
        add("DisplayName : " .. player.DisplayName)
        add("UserId      : " .. tostring(player.UserId))
        add("Waktu scan  : " .. os.date("%Y-%m-%d %H:%M:%S"))
        add("")
        if player ~= LocalPlayer then
            add("CATATAN: Data bergantung pada replikasi client.")
            add("")
        end

        local char = player.Character
        if not char then
            add("STATUS: Karakter tidak tersedia.")
            detailText.Text = table.concat(L, "\n")
            selectedLabel.Text = "Karakter tidak tersedia"
            scanning = false
            return
        end

        -- [1] HumanoidDescription
        add("----------------------------------------")
        add("[1] HUMANOID DESCRIPTION")
        add("----------------------------------------")
        local desc, descErr = getDescription(player)
        if desc then
            local fields = {
                {"Shirt","Shirt"},{"Pants","Pants"},
                {"GraphicTShirt","T-Shirt"},{"Face","Face"},
                {"Head","Head"},{"Torso","Torso"},
                {"LeftArm","Left Arm"},{"RightArm","Right Arm"},
                {"LeftLeg","Left Leg"},{"RightLeg","Right Leg"},
            }
            for _, f in ipairs(fields) do
                local ok, v = pcall(function() return desc[f[1]] end)
                add(string.format("%-10s ID: %s", f[2], fmtId(ok and v or nil)))
            end
            add("")
            add("Body Colors:")
            for _, p in ipairs({"HeadColor","TorsoColor","LeftArmColor",
                                "RightArmColor","LeftLegColor","RightLegColor"}) do
                local ok, c = pcall(function() return desc[p] end)
                add("  " .. p .. ": " .. (ok and fmtColor(c) or "N/A"))
            end
            flush()

            -- [2] Accessories dari description
            add("")
            add("----------------------------------------")
            add("[2] ACCESSORIES DARI DESCRIPTION")
            add("----------------------------------------")
            local ok, accs = pcall(function() return desc:GetAccessories(true) end)
            if ok and type(accs) == "table" then
                add("Jumlah entri: " .. #accs)
                for i, a in ipairs(accs) do
                    add("")
                    add("Accessory #" .. i)
                    add("  AssetId       : " .. fmtId(a.AssetId))
                    add("  AccessoryType : " .. tostring(a.AccessoryType))
                    add("  IsLayered     : " .. tostring(a.IsLayered))
                    add("  Order         : " .. tostring(a.Order))
                    add("  Puffiness     : " .. tostring(a.Puffiness))
                    if a.IsLayered then layeredCount += 1 end
                end
            else
                add("Gagal membaca accessories description.")
                errors += 1
            end
        else
            add("Description tidak terbaca: " .. tostring(descErr))
            errors += 1
        end
        flush()

        -- [3] Semua part & objek
        add("")
        add("========================================")
        add("[3] SEMUA PART DAN OBJEK KARAKTER")
        add("========================================")
        local descendants = char:GetDescendants()
        local actualAccessories = {}
        for _, o in ipairs(descendants) do
            if o:IsA("Accessory") then
                actualAccessories[#actualAccessories + 1] = o
            end
        end
        accessoryCount = #actualAccessories
        add("Total descendant : " .. #descendants)
        add("Accessory instance: " .. accessoryCount)
        add("")
        flush()

        for _, o in ipairs(descendants) do
            if o:IsA("BasePart") then
                partCount += 1
                if o:IsA("MeshPart") then meshPartCount += 1 end
                add("[PART] " .. o:GetFullName())
                add("  Class: " .. o.ClassName)
                add("  Size: " .. tostring(o.Size))
                add("  Position: " .. tostring(o.Position))
                add("  Transparency: " .. tostring(o.Transparency))
                if o:IsA("MeshPart") then
                    add("  MeshId: " .. fmtId(o.MeshId))
                    add("  TextureID: " .. fmtId(o.TextureID))
                end
                local sa = o:FindFirstChildOfClass("SurfaceAppearance")
                if sa then
                    add("  SurfaceAppearance: " .. sa:GetFullName())
                    add("  ColorMap: " .. fmtId(sa.ColorMap))
                    add("  NormalMap: " .. fmtId(sa.NormalMap))
                    add("  RoughnessMap: " .. fmtId(sa.RoughnessMap))
                    add("  MetalnessMap: " .. fmtId(sa.MetalnessMap))
                end
            end
            if o:IsA("SpecialMesh") then
                specialMeshCount += 1
                add("[SPECIAL MESH] " .. o:GetFullName())
                add("  MeshType: " .. tostring(o.MeshType))
                add("  MeshId: " .. fmtId(o.MeshId))
                add("  TextureId: " .. fmtId(o.TextureId))
            end
            if o:IsA("Decal") or o:IsA("Texture") then
                decalCount += 1
                add("[DECAL/TEXTURE] " .. o:GetFullName())
                add("  Class: " .. o.ClassName)
                add("  Texture: " .. fmtId(o.Texture))
            end
            if o:IsA("WrapLayer") then
                wrapLayerCount += 1
                add("[WRAP LAYER] " .. o:GetFullName())
                add("  ReferenceMeshId: " .. fmtId(o.ReferenceMeshId))
                add("  CageMeshId: " .. fmtId(o.CageMeshId))
            end
            if o:IsA("WrapTarget") then
                wrapTargetCount += 1
                add("[WRAP TARGET] " .. o:GetFullName())
                add("  CageMeshId: " .. fmtId(o.CageMeshId))
            end
            if o:IsA("Shirt") then
                add("[SHIRT] " .. o:GetFullName())
                add("  ShirtTemplate: " .. fmtId(o.ShirtTemplate))
            elseif o:IsA("Pants") then
                add("[PANTS] " .. o:GetFullName())
                add("  PantsTemplate: " .. fmtId(o.PantsTemplate))
            elseif o:IsA("ShirtGraphic") then
                add("[SHIRT GRAPHIC] " .. o:GetFullName())
                add("  Graphic: " .. fmtId(o.Graphic))
            end
        end
        flush()

        -- [4] Accessory instances
        add("")
        add("========================================")
        add("[4] DETAIL SETIAP ACCESSORY INSTANCE")
        add("========================================")
        if #actualAccessories == 0 then
            add("Tidak ada Accessory instance di character.")
        end
        for i, acc in ipairs(actualAccessories) do
            add("")
            add("ACCESSORY #" .. i)
            add("Name: " .. acc.Name)
            add("Path: " .. acc:GetFullName())
            local handle = acc:FindFirstChild("Handle")
            if handle then
                add("Handle: " .. handle:GetFullName())
                add("Handle Class: " .. handle.ClassName)
                if handle:IsA("MeshPart") then
                    add("Handle MeshId: " .. fmtId(handle.MeshId))
                    add("Handle TextureID: " .. fmtId(handle.TextureID))
                end
                for _, it in ipairs(handle:GetDescendants()) do
                    if it:IsA("SpecialMesh") then
                        add("  SpecialMesh: " .. it:GetFullName())
                        add("    MeshId: " .. fmtId(it.MeshId))
                        add("    TextureId: " .. fmtId(it.TextureId))
                    elseif it:IsA("Decal") or it:IsA("Texture") then
                        add("  Texture: " .. it:GetFullName())
                        add("    Texture: " .. fmtId(it.Texture))
                    elseif it:IsA("WrapLayer") then
                        add("  WrapLayer: " .. it:GetFullName())
                        add("    ReferenceMeshId: " .. fmtId(it.ReferenceMeshId))
                        add("    CageMeshId: " .. fmtId(it.CageMeshId))
                    end
                end
            else
                add("Handle: TIDAK DITEMUKAN")
            end
        end
        flush()

        -- [5] Status
        add("")
        add("========================================")
        add("[5] STATUS AKHIR PEMINDAIAN")
        add("========================================")
        add("Player: " .. player.Name)
        add("BasePart total: " .. partCount)
        add("MeshPart total: " .. meshPartCount)
        add("SpecialMesh total: " .. specialMeshCount)
        add("Accessory instance: " .. accessoryCount)
        add("Layered accessories (description): " .. layeredCount)
        add("Decal/Texture objects: " .. decalCount)
        add("WrapLayer total: " .. wrapLayerCount)
        add("WrapTarget total: " .. wrapTargetCount)
        add("Error pembacaan: " .. errors)
        add("")
        if player.Character == char then
            add("STATUS: PEMINDAIAN SELESAI")
            add("Semua descendant karakter yang tersedia pada")
            add("client saat pemindaian telah diperiksa.")
        else
            add("STATUS: KARAKTER BERUBAH SAAT PEMINDAIAN")
            add("Jalankan SCAN ULANG untuk karakter terbaru.")
        end
        add("")
        add("CATATAN:")
        add("- ID 0 = field HumanoidDescription tidak diset.")
        add("- MeshId bukan selalu ID katalog avatar.")
        add("- AssetId description adalah ID aset aksesori.")
        add("- Objek yang tidak direplikasi ke client tidak terlihat.")
        add("========================================")
        add("AKHIR HASIL PEMINDAIAN")

        detailText.Text = table.concat(L, "\n")
        detailScroll.CanvasPosition = Vector2.new(0, 0)
        selectedLabel.Text = "Selesai: " .. player.Name
        scanning = false
    end)
end

-- ===== Player list =====
local function refreshPlayers()
    for _, c in ipairs(playerScroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    playerButtons = {}
    local list = Players:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
    for _, p in ipairs(list) do
        local b = create("TextButton", {
            Name = "Player_" .. p.Name,
            Size = UDim2.new(1, 0, 0, 18),
            BackgroundColor3 = Color3.fromRGB(39, 48, 66),
            TextColor3 = Color3.fromRGB(235, 240, 255),
            Text = p.DisplayName .. "  (@" .. p.Name .. ")",
            TextSize = 8,
            Font = Enum.Font.Gotham,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0,
            AutoButtonColor = true,
        }, playerScroll)
        corner(b, 3)
        create("UIPadding", { PaddingLeft = UDim.new(0, 5) }, b)
        playerButtons[p] = b
        b.MouseButton1Click:Connect(function() scanPlayer(p) end)
    end
    playerScroll.CanvasPosition = Vector2.new(0, 0)
    updatePlayerCanvas()
end

local function filterPlayers()
    local q = search.Text:lower()
    for p, b in pairs(playerButtons) do
        if p.Parent == Players then
            b.Visible = q == ""
                or p.Name:lower():find(q, 1, true) ~= nil
                or p.DisplayName:lower():find(q, 1, true) ~= nil
        else
            b.Visible = false
        end
    end
    updatePlayerCanvas()
end

refresh.MouseButton1Click:Connect(function() refreshPlayers(); filterPlayers() end)
search:GetPropertyChangedSignal("Text"):Connect(filterPlayers)

scanBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Parent == Players then
        scanPlayer(selectedPlayer)
    else
        detailText.Text = "Pilih pemain dari daftar terlebih dahulu."
    end
end)

Players.PlayerAdded:Connect(function()
    task.defer(function() refreshPlayers(); filterPlayers() end)
end)

Players.PlayerRemoving:Connect(function(p)
    if selectedPlayer == p then
        selectedPlayer = nil
        selectedLabel.Text = "Pemain keluar"
        detailText.Text = "Pemain yang dipilih sudah keluar dari server."
    end
    task.defer(function() refreshPlayers(); filterPlayers() end)
end)

refreshPlayers()
filterPlayers()

detailText.Text =
