local function safeString(value)
    if value == nil then
        return "N/A"
    end
    return tostring(value)
end

local function addLine(lines, value)
    table.insert(lines, tostring(value))
end

local function getProperty(obj, prop)
    local ok, value = pcall(function()
        return obj[prop]
    end)
    if ok then
        return value
    end
    return nil
end

local function getDescription(player)
    local character = player.Character
    if not character then
        return nil, "Karakter belum tersedia."
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return nil, "Humanoid tidak ditemukan."
    end

    local ok, desc = pcall(function()
        return humanoid:GetAppliedDescription()
    end)

    if ok then
        return desc
    end

    return nil, "Gagal membaca HumanoidDescription."
end

local function scanPlayer(player)
    if scanning then
        return
    end

    scanning = true
    selectedPlayer = player
    selectedLabel.Text = "Memindai: " .. player.Name
    detailText.Text = "Sedang memindai avatar..."
    detailScroll.CanvasPosition = Vector2.new(0, 0)

    task.spawn(function()
        local lines = {}
        local partCount = 0
        local meshPartCount = 0
        local accessoryCount = 0
        local layeredCount = 0
        local specialMeshCount = 0
        local decalCount = 0
        local textureCount = 0
        local wrapLayerCount = 0
        local wrapTargetCount = 0
        local errors = 0

        addLine(lines, "========================================")
        addLine(lines, "AVATAR INSPECTOR - HASIL PEMINDAIAN")
        addLine(lines, "========================================")
        addLine(lines, "Player Name : " .. player.Name)
        addLine(lines, "DisplayName : " .. player.DisplayName)
        addLine(lines, "UserId      : " .. tostring(player.UserId))
        addLine(lines, "Waktu scan  : " .. os.date("%Y-%m-%d %H:%M:%S"))
        addLine(lines, "")

        if player ~= LocalPlayer then
            addLine(lines, "CATATAN: Data yang terbaca bergantung pada")
            addLine(lines, "objek avatar yang direplikasi ke client.")
            addLine(lines, "")
        end

        local character = player.Character
        if not character then
            addLine(lines, "STATUS: Karakter tidak tersedia.")
            detailText.Text = table.concat(lines, "\n")
            selectedLabel.Text = "Karakter tidak tersedia"
            scanning = false
            return
        end

        -- HumanoidDescription IDs
        addLine(lines, "----------------------------------------")
        addLine(lines, "[1] HUMANOID DESCRIPTION - BODY & CLOTHES")
        addLine(lines, "----------------------------------------")

        local desc, descError = getDescription(player)
        if desc then
            local properties = {
                {"Shirt", "Shirt"},
                {"Pants", "Pants"},
                {"GraphicTShirt", "T-Shirt / Graphic"},
                {"Face", "Face"},
                {"Head", "Head"},
                {"Torso", "Torso"},
                {"LeftArm", "Left Arm"},
                {"RightArm", "Right Arm"},
                {"LeftLeg", "Left Leg"},
                {"RightLeg", "Right Leg"}
            }

            for _, item in ipairs(properties) do
                local value = getProperty(desc, item[1])
                addLine(lines, item[2] .. " ID: " .. safeString(value))
            end

            addLine(lines, "")
            addLine(lines, "Body Colors:")

            for _, prop in ipairs({
                "HeadColor", "TorsoColor",
                "LeftArmColor", "RightArmColor",
                "LeftLegColor", "RightLegColor"
            }) do
                local color = getProperty(desc, prop)
                if typeof(color) == "Color3" then
                    addLine(lines, "  " .. prop .. ": " ..
                        string.format("#%02X%02X%02X",
                            math.floor(color.R * 255),
                            math.floor(color.G * 255),
                            math.floor(color.B * 255)))
                else
                    addLine(lines, "  " .. prop .. ": " .. safeString(color))
                end
            end

            -- Accessories from HumanoidDescription
            addLine(lines, "")
            addLine(lines, "----------------------------------------")
            addLine(lines, "[2] ACCESSORIES DARI DESCRIPTION")
            addLine(lines, "----------------------------------------")

            local ok, accessories = pcall(function()
                return desc:GetAccessories(true)
            end)

            if ok and type(accessories) == "table" then
                addLine(lines, "Jumlah entri description: " .. #accessories)

                for index, accessory in ipairs(accessories) do
                    addLine(lines, "")
                    addLine(lines, "Accessory #" .. index)
                    addLine(lines, "  AssetId: " ..
                        safeString(accessory.AssetId))
                    addLine(lines, "  AccessoryType: " ..
                        safeString(accessory.AccessoryType))
                    addLine(lines, "  IsLayered: " ..
                        safeString(accessory.IsLayered))
                    addLine(lines, "  Order: " ..
                        safeString(accessory.Order))
                    addLine(lines, "  Puffiness: " ..
                        safeString(accessory.Puffiness))

                    if accessory.IsLayered then
                        layeredCount += 1
                    end
                end
            else
                addLine(lines, "Gagal membaca daftar accessories description.")
                errors += 1
            end
        else
            addLine(lines, "Description tidak terbaca: " .. safeString(descError))
            errors += 1
        end

        -- Actual character hierarchy
        addLine(lines, "")
        addLine(lines, "========================================")
        addLine(lines, "[3] SEMUA PART DAN OBJEK KARAKTER")
        addLine(lines, "========================================")

        local descendants = character:GetDescendants()
        local actualAccessories = {}

        for _, obj in ipairs(descendants) do
            if obj:IsA("Accessory") then
                table.insert(actualAccessories, obj)
            end
        end

        accessoryCount = #actualAccessories

        addLine(lines, "Total descendant: " .. #descendants)
        addLine(lines, "Accessory instance: " .. accessoryCount)
        addLine(lines, "")

        for _, obj in ipairs(descendants) do
            if obj:IsA("BasePart") then
                partCount += 1

                if obj:IsA("MeshPart") then
                    meshPartCount += 1
                end

                addLine(lines, "[PART] " .. obj:GetFullName())
                addLine(lines, "  Class: " .. obj.ClassName)
                addLine(lines, "  Size: " .. tostring(obj.Size))
                addLine(lines, "  Position: " .. tostring(obj.Position))
                addLine(lines, "  Transparency: " .. tostring(obj.Transparency))

                if obj:IsA("MeshPart") then
                    addLine(lines, "  MeshId: " .. safeString(obj.MeshId))
                    addLine(lines, "  TextureID: " .. safeString(obj.TextureID))
                end

                local surfaceAppearance = obj:FindFirstChildOfClass("SurfaceAppearance")
                if surfaceAppearance then
                    addLine(lines, "  SurfaceAppearance: " ..
                        surfaceAppearance:GetFullName())
                    addLine(lines, "  ColorMap: " ..
                        safeString(surfaceAppearance.ColorMap))
                    addLine(lines, "  NormalMap: " ..
                        safeString(surfaceAppearance.NormalMap))
                    addLine(lines, "  RoughnessMap: " ..
                        safeString(surfaceAppearance.RoughnessMap))
                    addLine(lines, "  MetalnessMap: " ..
                        safeString(surfaceAppearance.MetalnessMap))
                end
            end

            if obj:IsA("SpecialMesh") then
                specialMeshCount += 1
                addLine(lines, "")
                addLine(lines, "[SPECIAL MESH] " .. obj:GetFullName())
                addLine(lines, "  MeshType: " .. safeString(obj.MeshType))
                addLine(lines, "  MeshId: " .. safeString(obj.MeshId))
                addLine(lines, "  TextureId: " .. safeString(obj.TextureId))
            end

            if obj:IsA("Decal") or obj:IsA("Texture") then
                decalCount += 1
                textureCount += 1
                addLine(lines, "")
                addLine(lines, "[DECAL/TEXTURE] " .. obj:GetFullName())
                addLine(lines, "  Class: " .. obj.ClassName)
                addLine(lines, "  Texture: " .. safeString(obj.Texture))
            end

            if obj:IsA("WrapLayer") then
                wrapLayerCount += 1
                addLine(lines, "")
                addLine(lines, "[WRAP LAYER] " .. obj:GetFullName())
                addLine(lines, "  ReferenceMeshId: " ..
                    safeString(getProperty(obj, "ReferenceMeshId")))
                addLine(lines, "  CageMeshId: " ..
                    safeString(getProperty(obj, "CageMeshId")))
            end

            if obj:IsA("WrapTarget") then
                wrapTargetCount += 1
                addLine(lines, "")
                addLine(lines, "[WRAP TARGET] " .. obj:GetFullName())
                addLine(lines, "  CageMeshId: " ..
                    safeString(getProperty(obj, "CageMeshId")))
            end

            if obj:IsA("Shirt") then
                addLine(lines, "")
                addLine(lines, "[SHIRT INSTANCE] " .. obj:GetFullName())
                addLine(lines, "  ShirtTemplate: " ..
                    safeString(obj.ShirtTemplate))
            elseif obj:IsA("Pants") then
                addLine(lines, "")
                addLine(lines, "[PANTS INSTANCE] " .. obj:GetFullName())
                addLine(lines, "  PantsTemplate: " ..
                    safeString(obj.PantsTemplate))
            elseif obj:IsA("ShirtGraphic") then
                addLine(lines, "")
                addLine(lines, "[SHIRT GRAPHIC] " .. obj:GetFullName())
                addLine(lines, "  Graphic: " .. safeString(obj.Graphic))
            end
        end

        -- Actual accessory hierarchy and contained objects
        addLine(lines, "")
        addLine(lines, "========================================")
        addLine(lines, "[4] DETAIL SETIAP ACCESSORY INSTANCE")
        addLine(lines, "========================================")

        if #actualAccessories == 0 then
            addLine(lines, "Tidak ada Accessory instance di character.")
        end

        for index, accessory in ipairs(actualAccessories) do
            addLine(lines, "")
            addLine(lines, "ACCESSORY INSTANCE #" .. index)
            addLine(lines, "Name: " .. accessory.Name)
            addLine(lines, "Path: " .. accessory:GetFullName())

            local handle = accessory:FindFirstChild("Handle")
            if handle then
                addLine(lines, "Handle: " .. handle:GetFullName())
                addLine(lines, "Handle Class: " .. handle.ClassName)

                if handle:IsA("MeshPart") then
                    addLine(lines, "Handle MeshId: " .. safeString(handle.MeshId))
                    addLine(lines, "Handle TextureID: " .. safeString(handle.TextureID))
                end

                for _, item in ipairs(handle:GetDescendants()) do
                    if item:IsA("SpecialMesh") then
                        addLine(lines, "  SpecialMesh: " .. item:GetFullName())
                        addLine(lines, "    MeshId: " .. safeString(item.MeshId))
                        addLine(lines, "    TextureId: " .. safeString(item.TextureId))
                    elseif item:IsA("Decal") or item:IsA("Texture") then
                        addLine(lines, "  Texture object: " .. item:GetFullName())
                        addLine(lines, "    Texture: " .. safeString(item.Texture))
                    elseif item:IsA("WrapLayer") then
                        addLine(lines, "  WrapLayer: " .. item:GetFullName())
                        addLine(lines, "    ReferenceMeshId: " ..
                            safeString(getProperty(item, "ReferenceMeshId")))
                        addLine(lines, "    CageMeshId: " ..
                            safeString(getProperty(item, "CageMeshId")))
                    end
                end
            else
                addLine(lines, "Handle: TIDAK DITEMUKAN")
            end
        end

        -- Final summary
        addLine(lines, "")
        addLine(lines, "========================================")
        addLine(lines, "[5] STATUS AKHIR PEMINDAIAN")
        addLine(lines, "========================================")
        addLine(lines, "Player: " .. player.Name)
        addLine(lines, "BasePart total: " .. partCount)
        addLine(lines, "MeshPart total: " .. meshPartCount)
        addLine(lines, "SpecialMesh total: " .. specialMeshCount)
        addLine(lines, "Accessory instance: " .. accessoryCount)
        addLine(lines, "Layered accessories (description): " .. layeredCount)
        addLine(lines, "Decal/Texture objects: " .. decalCount)
        addLine(lines, "Texture objects counted: " .. textureCount)
        addLine(lines, "WrapLayer total: " .. wrapLayerCount)
        addLine(lines, "WrapTarget total: " .. wrapTargetCount)
        addLine(lines, "Error pembacaan: " .. errors)
        addLine(lines, "")

        if player.Character == character then
            addLine(lines, "STATUS: PEMINDAIAN SELESAI")
            addLine(lines, "Semua descendant karakter yang tersedia pada")
            addLine(lines, "client saat pemindaian telah diperiksa.")
        else
            addLine(lines, "STATUS: KARAKTER BERUBAH SAAT PEMINDAIAN")
            addLine(lines, "Jalankan SCAN ULANG untuk karakter terbaru.")
        end

        addLine(lines, "")
        addLine(lines, "CATATAN:")
        addLine(lines, "- MeshId bukan selalu ID katalog avatar.")
        addLine(lines, "- AssetId description adalah ID aset aksesori.")
        addLine(lines, "- Objek yang tidak direplikasi ke client tidak")
        addLine(lines, "  dapat ditampilkan oleh LocalScript ini.")
        addLine(lines, "========================================")
        addLine(lines, "AKHIR HASIL PEMINDAIAN")

        detailText.Text = table.concat(lines, "\n")
        detailScroll.CanvasPosition = Vector2.new(0, 0)

        selectedLabel.Text = "Selesai: " .. player.Name
        scanning = false
    end)
end

-- Build player list
local function refreshPlayers()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    playerButtons = {}

    local list = Players:GetPlayers()
    table.sort(list, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    for _, player in ipairs(list) do
        local button = create("TextButton", {
            Name = "Player_" .. player.Name,
            Size = UDim2.new(1, -2, 0, 34),
            BackgroundColor3 = Color3.fromRGB(39, 48, 66),
            TextColor3 = Color3.fromRGB(235, 240, 255),
            Text = player.DisplayName .. "  (@" .. player.Name .. ")",
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BorderSizePixel = 0,
            AutoButtonColor = true,
            Visible = true
        }, playerScroll)

        corner(button, 5)
        playerButtons[player] = button

        button.MouseButton1Click:Connect(function()
            scanPlayer(player)
        end)
    end

    playerScroll.CanvasPosition = Vector2.new(0, 0)
end

local function filterPlayers()
    local query = search.Text:lower()

    for player, button in pairs(playerButtons) do
        if player.Parent == Players then
            button.Visible =
                query == ""
                or player.Name:lower():find(query, 1, true) ~= nil
                or player.DisplayName:lower():find(query, 1, true) ~= nil
        else
            button.Visible = false
        end
    end

    task.defer(function()
        playerScroll.CanvasSize = UDim2.new(
            0, 0, 0, playerLayout.AbsoluteContentSize.Y + 14
        )
    end)
end

refresh.MouseButton1Click:Connect(function()
    refreshPlayers()
    filterPlayers()
end)

search:GetPropertyChangedSignal("Text"):Connect(filterPlayers)

scanBtn.MouseButton1Click:Connect(function()
    if selectedPlayer and selectedPlayer.Parent == Players then
        scanPlayer(selectedPlayer)
    else
        detailText.Text = "Pilih pemain dari daftar terlebih dahulu."
    end
end)

playerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    playerScroll.CanvasSize = UDim2.new(
        0, 0, 0, playerLayout.AbsoluteContentSize.Y + 14
    )
end)

Players.PlayerAdded:Connect(function()
    task.defer(function()
        refreshPlayers()
        filterPlayers()
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    if selectedPlayer == player then
        selectedPlayer = nil
        selectedLabel.Text = "Pemain keluar"
        detailText.Text = "Pemain yang dipilih sudah keluar dari server."
    end

    task.defer(function()
        refreshPlayers()
        filterPlayers()
    end)
end)

