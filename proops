--====================================================
-- SCAN PROP MILIK SENDIRI
--====================================================
local function scanMyProps()
    myProps = {}
    local seen = {}
    local username = localPlayer.Name:lower()
    local ownedName = "prop" .. username
    local folders = {
        workspace:FindFirstChild("WorkspaceCom"),
        workspace:FindFirstChild("bh_Props"),
        workspace:FindFirstChild("Props"),
    }

    local function inspect(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
        if seen[obj] then return end
        local name = obj.Name:lower()
        local remote = obj:FindFirstChild("SetCurrentCFrame", true)
        if not remote or not remote:IsA("RemoteFunction") then return end
        -- cek kepemilikan
        local ownerMatch = name == ownedName
            or (name:find("prop", 1, true) and name:find(username, 1, true))
        if not ownerMatch then return end
        seen[obj] = true
        table.insert(myProps, {
            object = obj,
            remote = remote,
        })
    end

    for _, folder in ipairs(folders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do inspect(obj) end
            inspect(folder)
        end
    end

    -- urutkan berdasarkan nama biar stabil
    table.sort(myProps, function(a, b)
        return a.object.Name:lower() < b.object.Name:lower()
    end)

    -- tampilkan di list
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    for i, data in ipairs(myProps) do
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -8, 0, 22)
        lbl.LayoutOrder = i
        lbl.BackgroundColor3 = Color3.fromRGB(50, 54, 73)
        lbl.Text = " " .. i .. ". " .. data.object.Name
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.Gotham
        lbl.Parent = listFrame
        round(lbl, 4)
    end
    listFrame.CanvasSize = UDim2.fromOffset(0, #myProps * 26 + 8)
    info.Text = "Prop terdeteksi: " .. #myProps
    setStatus(#myProps > 0
        and ("Ditemukan " .. #myProps .. " prop milikmu. Atur jarak lalu MULAI.")
        or "Tidak ada prop milikmu. Spawn prop manual dahulu.")
end

listen(scanBtn.MouseButton1Click:Connect(scanMyProps))

--====================================================
-- HITUNG POSISI GRID
--====================================================
-- Posisi grid relatif terhadap root player, di belakang player.
-- Grid: rowBox prop per baris, spacingBox jarak antar prop.
local function computeGridPosition(index, total, rootCF, spacing, perRow, heightOffset)
    local row = math.floor((index - 1) / perRow)
    local col = (index - 1) % perRow
    -- center kolom
    local rowCount = math.min(perRow, total - row * perRow)
    local colOffset = (col - (rowCount - 1) / 2) * spacing
    -- baris ke belakang (di belakang player)
    local backOffset = (row + 1) * spacing
    -- local space: X = kiri/kanan, Z = belakang (negatif karena LookVector ke depan)
    local localPos = Vector3.new(colOffset, heightOffset, -backOffset)
    return rootCF * localPos
end

--====================================================
-- FOLLOW LOOP
--====================================================
local function stopFollow()
    followRunning = false
    followToken += 1
    toggleBtn.Text = "MULAI FOLLOW: OFF"
    toggleBtn.BackgroundColor3 = COLORS.green
    setStatus("Follow dihentikan.")
end

local function startFollow()
    if followRunning then return end
    if #myProps == 0 then
        setStatus("Scan prop dulu sebelum mulai.")
        return
    end

    local spacing = math.clamp(tonumber(spacingBox.Text) or 6, 1, 40)
    local perRow = math.clamp(math.floor(tonumber(rowBox.Text) or 3), 1, 20)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 3, -10, 30)

    followRunning = true
    followToken += 1
    local myToken = followToken
    toggleBtn.Text = "STOP FOLLOW"
    toggleBtn.BackgroundColor3 = COLORS.red
    setStatus("Follow ON | " .. #myProps .. " prop | jarak " .. spacing .. " studs")

    local total = #myProps
    -- counter untuk throttle status
    local lastStatusTime = 0

    listen(RunService.Heartbeat:Connect(function()
        if not followRunning or followToken ~= myToken then return end
        if not gui.Parent then stopFollow() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            if os.clock() - lastStatusTime > 1 then
                setStatus("Menunggu karakter...")
                lastStatusTime = os.clock()
            end
            return
        end

        local rootCF = root.CFrame
        local okCount, errCount = 0, 0

        for i, data in ipairs(myProps) do
            local obj = data.object
            local remote = data.remote
            if obj and obj.Parent and remote and remote.Parent and remote:IsA("RemoteFunction") then
                local goalPos = computeGridPosition(i, total, rootCF, spacing, perRow, heightOffset)
                -- pertahankan rotasi asli prop
                local okRot, origCF = pcall(function() return obj:GetPivot() end)
                local goalCF = CFrame.new(goalPos)
                if okRot then
                    goalCF = CFrame.new(goalPos) * origCF.Rotation
                end
                local ok = pcall(function() remote:InvokeServer(goalCF) end)
                if ok then okCount += 1 else errCount += 1 end
            else
                errCount += 1
            end
        end

        if os.clock() - lastStatusTime > 0.5 then
            setStatus(string.format("Follow ON | OK: %d | Error: %d", okCount, errCount))
            lastStatusTime = os.clock()
        end
    end))
end

listen(toggleBtn.MouseButton1Click:Connect(function()
    if followRunning then stopFollow() else startFollow() end
end))

--====================================================
-- DRAG
--====================================================
local dragging = false
local dragInput
local dragStart
local startPos
listen(header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end))
listen(UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end))

