--====================================================
-- ASSIGN SLOT KE BAGIAN TUBUH
-- Bagian: head(1), body(1), armL(3), armR(3), legL(2), legR(2)
-- Sisa prop -> aura (lingkaran di sekitar badan)
--====================================================
local function assignSlots()
    assignedSlots = {}
    local cursor = 1
    local function take(n, part)
        local arr = {}
        for k = 1, n do
            local data = myProps[cursor]
            if not data then break end
            table.insert(arr, { object = data.object, remote = data.remote, part = part, index = k })
            cursor += 1
        end
        return arr
    end

    local head  = take(1, "head")
    local body  = take(1, "body")
    local armL  = take(3, "armL")
    local armR  = take(3, "armR")
    local legL  = take(2, "legL")
    local legR  = take(2, "legR")

    for _, list in ipairs({head, body, armL, armR, legL, legR}) do
        for _, slot in ipairs(list) do table.insert(assignedSlots, slot) end
    end

    -- sisa prop -> aura
    local auraIndex = 1
    while myProps[cursor] do
        local data = myProps[cursor]
        table.insert(assignedSlots, {
            object = data.object,
            remote = data.remote,
            part = "aura",
            index = auraIndex,
        })
        auraIndex += 1
        cursor += 1
    end

    info.Text = "Prop: " .. #myProps .. " | Slot tubuh: " .. #assignedSlots
end

listen(scanBtn.MouseButton1Click:Connect(function()
    task.defer(assignSlots)
end))

--====================================================
-- POSISI LOKAL TIAP BAGIAN TUBUH (unit lokal × skala)
-- X = kanan/kiri, Y = atas/bawah, Z = depan/belakang
--====================================================
local function slotLocalPos(slot, scale, phase)
    local p = slot.part
    local i = slot.index

    if p == "head" then
        return Vector3.new(0, 9, 0) * scale
    elseif p == "body" then
        return Vector3.new(0, 5, 0) * scale
    elseif p == "armL" then
        -- tangan kiri: menjulur ke samping kiri + naik, berayun naik-turun
        local swing = math.sin(phase) * 0.5
        local base = Vector3.new(-3 - i * 1.2, 6 - i * 1.5 + swing, 0)
        return base * scale
    elseif p == "armR" then
        local swing = math.sin(phase + math.pi) * 0.5
        local base = Vector3.new(3 + i * 1.2, 6 - i * 1.5 + swing, 0)
        return base * scale
    elseif p == "legL" then
        -- kaki kiri: lurus ke bawah, i=1 lebih tinggi
        local swing = math.sin(phase) * 0.3
        local base = Vector3.new(-1.8, 3 - i * 1.4, swing)
        return base * scale
    elseif p == "legR" then
        local swing = math.sin(phase + math.pi) * 0.3
        local base = Vector3.new(1.8, 3 - i * 1.4, swing)
        return base * scale
    elseif p == "aura" then
        local angle = i * 1.3 + phase * 0.5
        local radius = 7
        local base = Vector3.new(
            math.cos(angle) * radius,
            5 + math.sin(angle * 2) * 1.5,
            math.sin(angle) * radius
        )
        return base * scale
    end
    return Vector3.zero
end

--====================================================
-- UPDATE MONSTER
--====================================================
local function updateMonster(centerCF, scale, heightOffset, phase)
    local okCount, errCount = 0, 0
    for _, slot in ipairs(assignedSlots) do
        local obj = slot.object
        local remote = slot.remote
        if obj and obj.Parent and remote and remote.Parent and remote:IsA("RemoteFunction") then
            local localPos = slotLocalPos(slot, scale, phase) + Vector3.new(0, heightOffset, 0)
            local worldPos = centerCF * localPos
            local goalCF = CFrame.new(worldPos) * centerCF.Rotation
            local ok = pcall(function() remote:InvokeServer(goalCF) end)
            if ok then okCount += 1 else errCount += 1 end
        else
            errCount += 1
        end
    end
    return okCount, errCount
end

--====================================================
-- FOLLOW / ATTACK
--====================================================
local function stopAll()
    followRunning = false
    attackRunning = false
    followToken += 1
    followBtn.Text = "FOLLOW SAYA: OFF"
    followBtn.BackgroundColor3 = COLORS.green
    attackBtn.Text = "KEJAR TARGET: OFF"
    attackBtn.BackgroundColor3 = COLORS.orange
    setStatus("Monster dihentikan.")
end

local function startFollow()
    if followRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end
    if #assignedSlots == 0 then assignSlots() end

    local scale = math.clamp(tonumber(scaleBox.Text) or 3, 0.5, 20)
    local distance = math.clamp(tonumber(distBox.Text) or 8, 2, 60)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 2, -10, 40)

    attackRunning = false
    attackBtn.Text = "KEJAR TARGET: OFF"
    attackBtn.BackgroundColor3 = COLORS.orange
    followRunning = true
    followToken += 1
    local myToken = followToken
    followBtn.Text = "FOLLOW SAYA: ON"
    followBtn.BackgroundColor3 = COLORS.red
    setStatus("Monster mengikuti kamu | skala " .. scale)

    local lastStatusTime = 0
    animPhase = 0
    listen(RunService.Heartbeat:Connect(function(dt)
        if not followRunning or followToken ~= myToken then return end
        if not gui.Parent then stopAll() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            if os.clock() - lastStatusTime > 1 then
                setStatus("Menunggu karakter...")
                lastStatusTime = os.clock()
            end
            return
        end

        animPhase += dt * 4 -- kecepatan animasi ayunan

        -- monster di belakang player, menghadap arah yang sama dengan player
        local back = root.CFrame.LookVector * -distance
        local centerPos = root.Position + back
        local centerCF = CFrame.new(centerPos, centerPos + root.CFrame.LookVector)
        local okCount, errCount = updateMonster(centerCF, scale, heightOffset, animPhase)

        if os.clock() - lastStatusTime > 0.5 then
            setStatus(string.format("Monster ON | OK: %d | Err: %d", okCount, errCount))
            lastStatusTime = os.clock()
        end
    end))
end

local function startAttack()
    if attackRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end
    if #assignedSlots == 0 then assignSlots() end

    local target = nil
    local myChar = localPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or Vector3.zero
    local bestDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - myPos).Magnitude
                if d < bestDist then bestDist = d; target = p end
            end
        end
    end
    if not target then setStatus("Tidak ada target lain di server.") return end

    local scale = math.clamp(tonumber(scaleBox.Text) or 3, 0.5, 20)
    local distance = math.clamp(tonumber(distBox.Text) or 8, 2, 60)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 2, -10, 40)

    followRunning = false
    followBtn.Text = "FOLLOW SAYA: OFF"
    followBtn.BackgroundColor3 = COLORS.green
    attackRunning = true
    followToken += 1
    local myToken = followToken
    attackBtn.Text = "KEJAR TARGET: ON"
    attackBtn.BackgroundColor3 = COLORS.red
    setStatus("Monster mengejar @" .. target.Name)

    local lastStatusTime = 0
    animPhase = 0
    listen(RunService.Heartbeat:Connect(function(dt)
        if not attackRunning or followToken ~= myToken then return end
        if not gui.Parent then stopAll() return end
        if target.Parent ~= Players then stopAll(); setStatus("Target keluar.") return end

        local tChar = target.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not tRoot or not tHum or tHum.Health <= 0 then
            if os.clock() - lastStatusTime > 1 then
                setStatus("Menunggu target...")
                lastStatusTime = os.clock()
            end
            return
        end

        animPhase += dt * 6

        local back = tRoot.CFrame.LookVector * -distance
        local centerPos = tRoot.Position + back
        local centerCF = CFrame.new(centerPos, tRoot.Position)
        local okCount, errCount = updateMonster(centerCF, scale, heightOffset, animPhase)

        if os.clock() - lastStatusTime > 0.5 then
            setStatus(string.format("Kejar @%s | OK: %d | Err: %d",
                target.Name, okCount, errCount))
            lastStatusTime = os.clock()
        end
    end))
end

listen(followBtn.MouseButton1Click:Connect(function()
    if followRunning then stopAll() else startFollow() end
end))
listen(attackBtn.MouseButton1Click:Connect(function()
    if attackRunning then stopAll() else startAttack() end
end))

