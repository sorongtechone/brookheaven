--====================================================
-- SCAN PROP
--====================================================
local function scanMyProps()
    myProps = {}
    local seen = {}
    local username = localPlayer.Name:lower()
    local ownedName = "prop" .. username
    local folders = {
        workspace:FindFirstChild("WorkspaceCom"),
        workspace:FindFirstChild("bh_Props"),
        workspace:FindFirstChild("Props"),
    }

    local function inspect(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
        if seen[obj] then return end
        local name = obj.Name:lower()
        local remote = obj:FindFirstChild("SetCurrentCFrame", true)
        if not remote or not remote:IsA("RemoteFunction") then return end
        local ownerMatch = name == ownedName
            or (name:find("prop", 1, true) and name:find(username, 1, true))
        if not ownerMatch then return end
        seen[obj] = true
        table.insert(myProps, { object = obj, remote = remote })
    end

    for _, folder in ipairs(folders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do inspect(obj) end
            inspect(folder)
        end
    end

    table.sort(myProps, function(a, b)
        return a.object.Name:lower() < b.object.Name:lower()
    end)

    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    for i, data in ipairs(myProps) do
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -8, 0, 22)
        lbl.LayoutOrder = i
        lbl.BackgroundColor3 = Color3.fromRGB(50, 54, 73)
        lbl.Text = " " .. i .. ". " .. data.object.Name
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextSize = 11
        lbl.Font = Enum.Font.Gotham
        lbl.Parent = listFrame
        round(lbl, 4)
    end
    listFrame.CanvasSize = UDim2.fromOffset(0, #myProps * 25 + 6)
    info.Text = "Prop terdeteksi: " .. #myProps
    setStatus(#myProps > 0
        and ("Ditemukan " .. #myProps .. " prop. Atur lalu MULAI SNAKE.")
        or "Tidak ada prop milikmu. Spawn prop manual dahulu.")
end

listen(scanBtn.MouseButton1Click:Connect(scanMyProps))

--====================================================
-- TRAIL HELPER
--====================================================
local function pushTrail(pos, maxLen)
    table.insert(trail, 1, pos)
    while #trail > maxLen do
        table.remove(trail)
    end
end

-- Ambil posisi trail ke-N (dalam studs di belakang), fallback ke posisi terakhir
local function trailAt(distanceStuds, spacing, rootPos)
    -- kita pakai index berdasar spacing: tiap prop butuh spacing studs di trail.
    -- trail disimpan tiap frame, jadi jarak tempuh per frame bervariasi.
    -- Solusi: cari titik trail yang jarak kumulatifnya >= distanceStuds.
    if #trail == 0 then return rootPos end
    local needed = distanceStuds
    local acc = 0
    local prev = rootPos
    for i = 1, #trail do
        local p = trail[i]
        acc += (prev - p).Magnitude
        if acc >= needed then
            return p
        end
        prev = p
    end
    -- kalau trail kurang panjang, pakai titik terakhir
    return trail[#trail]
end

--====================================================
-- SNAKE FOLLOW
--====================================================
local function stopFollow()
    followRunning = false
    followToken += 1
    toggleBtn.Text = "MULAI SNAKE: OFF"
    toggleBtn.BackgroundColor3 = COLORS.green
    setStatus("Snake dihentikan.")
end

local function startFollow()
    if followRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end

    local spacing = math.clamp(tonumber(spacingBox.Text) or 5, 1, 40)
    local maxTrail = math.clamp(math.floor(tonumber(historyBox.Text) or 80), 20, 400)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 3, -10, 30)

    -- reset trail
    trail = {}

    followRunning = true
    followToken += 1
    local myToken = followToken
    toggleBtn.Text = "STOP SNAKE"
    toggleBtn.BackgroundColor3 = COLORS.red
    setStatus("Snake ON | " .. #myProps .. " prop | spasi " .. spacing)

    local lastStatusTime = 0

    listen(RunService.Heartbeat:Connect(function()
        if not followRunning or followToken ~= myToken then return end
        if not gui.Parent then stopFollow() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            if os.clock() - lastStatusTime > 1 then
                setStatus("Menunggu karakter...")
                lastStatusTime = os.clock()
            end
            return
        end

        local rootPos = root.Position
        pushTrail(rootPos, maxTrail)

        local okCount, errCount = 0, 0
        local total = #myProps

        for i, data in ipairs(myProps) do
            local obj = data.object
            local remote = data.remote
            if obj and obj.Parent and remote and remote.Parent and remote:IsA("RemoteFunction") then
                -- prop ke-i berjarak (i * spacing) studs dari player di trail
                local targetPos = trailAt(i * spacing, spacing, rootPos)
                targetPos = targetPos + Vector3.new(0, heightOffset, 0)

                -- pertahankan rotasi asli
                local okRot, origCF = pcall(function() return obj:GetPivot() end)
                local goalCF = CFrame.new(targetPos)
                if okRot then
                    goalCF = CFrame.new(targetPos) * origCF.Rotation
                end

                local ok = pcall(function() remote:InvokeServer(goalCF) end)
                if ok then okCount += 1 else errCount += 1 end
            else
                errCount += 1
            end
        end

        if os.clock() - lastStatusTime > 0.5 then
            setStatus(string.format("Snake ON | OK: %d | Error: %d | Trail: %d",
                okCount, errCount, #trail))
            lastStatusTime = os.clock()
        end
    end))
end

listen(toggleBtn.MouseButton1Click:Connect(function()
    if followRunning then stopFollow() else startFollow() end
end))

--====================================================
-- DRAG
--====================================================
local dragging = false
local dragStart
local startPos
listen(header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end))
listen(UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end))

listen(closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end))

gui.Destroying:Connect(function()
    followRunning = false
    followToken += 1
    for _, c in ipairs(propConnections) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(connections) do
        if c.Connected then c:Disconnect() end
    end
    table.clear(connections)
end)

