--====================================================
-- SKELETON MONSTER (slot tubuh dalam unit lokal)
-- Koordinat lokal: X = kanan/kiri, Y = atas/bawah, Z = depan/belakang
-- Tiap slot punya "offset" (posisi) dan "rotation" (kemiringan prop)
-- Rotation dikalikan setelah rotasi pusat, jadi prop ikut miring
--====================================================
local function buildSkeleton()
    local S = {}
    local function add(pos, rot)
        table.insert(S, { offset = pos, rotation = rot or CFrame.new() })
    end

    -- Kepala (1 prop)
    add(Vector3.new(0, 8, 0))

    -- Badan (tumpuk vertikal)
    add(Vector3.new(0, 6, 0))
    add(Vector3.new(0, 4.5, 0))
    add(Vector3.new(0, 3, 0))

    -- Tangan kiri (melengkung ke bawah + prop miring mengikuti arah lengan)
    add(Vector3.new(-3, 5.5, 0), CFrame.Angles(0, 0,  math.rad(-20)))
    add(Vector3.new(-5, 4.5, 0), CFrame.Angles(0, 0,  math.rad(-45)))
    add(Vector3.new(-7, 3.5, 0), CFrame.Angles(0, 0,  math.rad(-70)))

    -- Tangan kanan (melengkung ke bawah + prop miring)
    add(Vector3.new(3, 5.5, 0), CFrame.Angles(0, 0,  math.rad(20)))
    add(Vector3.new(5, 4.5, 0), CFrame.Angles(0, 0,  math.rad(45)))
    add(Vector3.new(7, 3.5, 0), CFrame.Angles(0, 0,  math.rad(70)))

    -- Kaki kiri
    add(Vector3.new(-1.8, 1.5, 0))
    add(Vector3.new(-1.8, 0, 0))

    -- Kaki kanan
    add(Vector3.new(1.8, 1.5, 0))
    add(Vector3.new(1.8, 0, 0))

    -- Ekor (rebah ke belakang, makin ujung makin rebah)
    add(Vector3.new(0, 2, 3),   CFrame.Angles(math.rad(45), 0, 0))
    add(Vector3.new(0, 1.5, 5), CFrame.Angles(math.rad(65), 0, 0))
    add(Vector3.new(0, 1, 7),   CFrame.Angles(math.rad(80), 0, 0))

    -- Sayap kiri (melebar miring ke luar)
    add(Vector3.new(-6, 7, -2), CFrame.Angles(0, math.rad(20),  math.rad(-35)))
    add(Vector3.new(-9, 8, -3), CFrame.Angles(0, math.rad(35),  math.rad(-55)))

    -- Sayap kanan
    add(Vector3.new(6, 7, -2), CFrame.Angles(0, math.rad(-20), math.rad(35)))
    add(Vector3.new(9, 8, -3), CFrame.Angles(0, math.rad(-35), math.rad(55)))

    -- Tanduk (miring ke atas luar)
    add(Vector3.new(-1.5, 10, 0), CFrame.Angles(0, 0, math.rad(-25)))
    add(Vector3.new(1.5, 10, 0),  CFrame.Angles(0, 0, math.rad(25)))

    -- Tambahan (kalau prop lebih banyak) — spiral mengelilingi badan
    for i = 1, 30 do
        local angle = i * 1.1
        add(
            Vector3.new(
                math.cos(angle) * 6,
                5 + math.sin(angle) * 3,
                math.sin(angle) * 6
            ),
            CFrame.Angles(0, angle, math.rad(30))
        )
    end
    return S
end

local SKELETON = buildSkeleton()

local function assignSlots()
    assignedSlots = {}
    for i, data in ipairs(myProps) do
        local slot = SKELETON[i]
        local offset, rotation
        if slot then
            offset = slot.offset
            rotation = slot.rotation
        else
            -- fallback: lingkaran di sekitar badan
            local angle = i * 1.3
            offset = Vector3.new(math.cos(angle) * 8, 3, math.sin(angle) * 8)
            rotation = CFrame.Angles(0, angle, math.rad(30))
        end
        table.insert(assignedSlots, {
            object = data.object,
            remote = data.remote,
            offset = offset,
            rotation = rotation,
        })
    end
    info.Text = "Prop: " .. #myProps .. " | Slot tubuh: " .. #assignedSlots
end

--====================================================
-- UPDATE MONSTER
--====================================================
local function updateMonster(centerCF, scale, heightOffset)
    local okCount, errCount = 0, 0
    for _, slot in ipairs(assignedSlots) do
        local obj = slot.object
        local remote = slot.remote
        if obj and obj.Parent and remote and remote.Parent and remote:IsA("RemoteFunction") then
            local localPos = slot.offset * scale + Vector3.new(0, heightOffset, 0)
            local worldPos = centerCF * localPos
            -- posisi ikut skala, tapi rotasi lokal tetap (tidak diskalakan)
            local goalCF = CFrame.new(worldPos) * centerCF.Rotation * slot.rotation
            local ok = pcall(function() remote:InvokeServer(goalCF) end)
            if ok then okCount += 1 else errCount += 1 end
        else
            errCount += 1
        end
    end
    return okCount, errCount
end

--====================================================
-- FOLLOW / ATTACK
--====================================================
local function stopAll()
    followRunning = false
    attackRunning = false
    followToken += 1
    followBtn.Text = "FOLLOW SAYA: OFF"
    followBtn.BackgroundColor3 = COLORS.green
    attackBtn.Text = "KEJAR TARGET: OFF"
    attackBtn.BackgroundColor3 = COLORS.orange
    setStatus("Monster dihentikan.")
end

local function startFollow()
    if followRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end
    if #assignedSlots == 0 then assignSlots() end

    local scale = math.clamp(tonumber(scaleBox.Text) or 3, 0.5, 20)
    local distance = math.clamp(tonumber(distBox.Text) or 8, 2, 60)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 2, -10, 40)

    attackRunning = false
    attackBtn.Text = "KEJAR TARGET: OFF"
    attackBtn.BackgroundColor3 = COLORS.orange
    followRunning = true
    followToken += 1
    local myToken = followToken
    followBtn.Text = "FOLLOW SAYA: ON"
    followBtn.BackgroundColor3 = COLORS.red
    setStatus("Monster mengikuti kamu | skala " .. scale)

    local lastStatusTime = 0
    listen(RunService.Heartbeat:Connect(function()
        if not followRunning or followToken ~= myToken then return end
        if not gui.Parent then stopAll() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then
            if os.clock() - lastStatusTime > 1 then
                setStatus("Menunggu karakter...")
                lastStatusTime = os.clock()
            end
            return
        end

        -- posisi monster di belakang player
        local back = root.CFrame.LookVector * -distance
        local centerPos = root.Position + back
        local centerCF = CFrame.new(centerPos, centerPos + root.CFrame.LookVector)
        local okCount, errCount = updateMonster(centerCF, scale, heightOffset)

        if os.clock() - lastStatusTime > 0.5 then
            setStatus(string.format("Monster ON | OK: %d | Err: %d", okCount, errCount))
            lastStatusTime = os.clock()
        end
    end))
end

local function startAttack()
    if attackRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end
    if #assignedSlots == 0 then assignSlots() end

    local target = nil
    -- target = pemain terdekat selain diri sendiri
    local myChar = localPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myRoot and myRoot.Position or Vector3.zero
    local bestDist = math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= localPlayer and p.Character then
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then
                local d = (r.Position - myPos).Magnitude
                if d < bestDist then bestDist = d; target = p end
            end
        end
    end
    if not target then setStatus("Tidak ada target lain di server.") return end

    local scale = math.clamp(tonumber(scaleBox.Text) or 3, 0.5, 20)
    local distance = math.clamp(tonumber(distBox.Text) or 8, 2, 60)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 2, -10, 40)

    followRunning = false
    followBtn.Text = "FOLLOW SAYA: OFF"
    followBtn.BackgroundColor3 = COLORS.green
    attackRunning = true
    followToken += 1
    local myToken = followToken
    attackBtn.Text = "KEJAR TARGET: ON"
    attackBtn.BackgroundColor3 = COLORS.red
    setStatus("Monster mengejar @" .. target.Name)

    local lastStatusTime = 0
    listen(RunService.Heartbeat:Connect(function()
        if not attackRunning or followToken ~= myToken then return end
        if not gui.Parent then stopAll() return end
        if target.Parent ~= Players then stopAll(); setStatus("Target keluar.") return end

        local tChar = target.Character
        local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if not tRoot or not tHum or tHum.Health <= 0 then
            if os.clock() - lastStatusTime > 1 then
                setStatus("Menunggu target...")
                lastStatusTime = os.clock()
            end
            return
        end

        -- monster berdiri di belakang target
        local back = tRoot.CFrame.LookVector * -distance
        local centerPos = tRoot.Position + back
        local centerCF = CFrame.new(centerPos, tRoot.Position)
        local okCount, errCount = updateMonster(centerCF, scale, heightOffset)

        if os.clock() - lastStatusTime > 0.5 then
            setStatus(string.format("Kejar @%s | OK: %d | Err: %d",
                target.Name, okCount, errCount))
            lastStatusTime = os.clock()
        end
    end))
end

listen(followBtn.MouseButton1Click:Connect(function()
    if followRunning then stopAll() else startFollow() end
end))
listen(attackBtn.MouseButton1Click:Connect(function()
    if attackRunning then stopAll() else startAttack() end
end))

