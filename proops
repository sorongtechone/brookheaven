--====================================================
-- SKELETON ORANG (TEPAT 15 SLOT)
-- urutan:
--   1..3   : tangan kiri (3)
--   4..6   : tangan kanan (3)
--   7..8   : kaki kiri (2)
--   9..10  : kaki kanan (2)
--   11..15 : badan + kepala (5)
--
-- x, y = posisi dalam "unit tubuh":
--   x = -1 (kiri) sampai +1 (kanan)
--   y = 0 (kaki) sampai 1 (ujung kepala)
-- rotZ = kemiringan prop terhadap sumbu Z (derajat)
--====================================================
local function buildHumanSkeleton()
    local S = {}

    -- ===== TANGAN KIRI (3 prop) =====
    -- bahu -> lengan atas -> tangan
    table.insert(S, { name = "Tangan Kiri 1", x = -0.55, y = 0.82, rotZ =  20 })
    table.insert(S, { name = "Tangan Kiri 2", x = -0.75, y = 0.68, rotZ =  55 })
    table.insert(S, { name = "Tangan Kiri 3", x = -0.90, y = 0.50, rotZ =  85 })

    -- ===== TANGAN KANAN (3 prop) =====
    table.insert(S, { name = "Tangan Kanan 1", x =  0.55, y = 0.82, rotZ = -20 })
    table.insert(S, { name = "Tangan Kanan 2", x =  0.75, y = 0.68, rotZ = -55 })
    table.insert(S, { name = "Tangan Kanan 3", x =  0.90, y = 0.50, rotZ = -85 })

    -- ===== KAKI KIRI (2 prop) =====
    -- paha -> kaki
    table.insert(S, { name = "Kaki Kiri 1", x = -0.18, y = 0.30, rotZ = 0 })
    table.insert(S, { name = "Kaki Kiri 2", x = -0.18, y = 0.05, rotZ = 0 })

    -- ===== KAKI KANAN (2 prop) =====
    table.insert(S, { name = "Kaki Kanan 1", x =  0.18, y = 0.30, rotZ = 0 })
    table.insert(S, { name = "Kaki Kanan 2", x =  0.18, y = 0.05, rotZ = 0 })

    -- ===== BADAN + KEPALA (5 prop) =====
    -- bawah -> tengah -> atas -> leher -> kepala
    table.insert(S, { name = "Badan Bawah",  x = 0, y = 0.40, rotZ = 0 })
    table.insert(S, { name = "Badan Tengah", x = 0, y = 0.55, rotZ = 0 })
    table.insert(S, { name = "Badan Atas",   x = 0, y = 0.70, rotZ = 0 })
    table.insert(S, { name = "Leher",        x = 0, y = 0.83, rotZ = 0 })
    table.insert(S, { name = "Kepala",       x = 0, y = 0.94, rotZ = 0 })

    return S
end

local HUMAN_SKELETON = buildHumanSkeleton()

--====================================================
-- ASSIGN SLOT
-- Prop diurutkan ulang supaya tiap bagian dapat porsi yang pas.
-- Kalau prop kurang dari 15, slot diisi mulai dari yang paling
-- penting dulu (badan & kepala), lalu tangan, lalu kaki.
--
-- Urutan prioritas pengisian (biar siluet orang langsung kebentuk):
--   1. Badan (bawah, tengah, atas)
--   2. Kepala
--   3. Leher (kalau ada)
--   4. Tangan kiri & kanan (silih berganti)
--   5. Kaki kiri & kanan
--====================================================
local PRIORITY_ORDER = {
    "Badan Bawah", "Badan Tengah", "Badan Atas",
    "Kepala", "Leher",
    "Tangan Kiri 1", "Tangan Kanan 1",
    "Tangan Kiri 2", "Tangan Kanan 2",
    "Tangan Kiri 3", "Tangan Kanan 3",
    "Kaki Kiri 1", "Kaki Kanan 1",
    "Kaki Kiri 2", "Kaki Kanan 2",
}

local function assignSlots(scale, gap)
    assignedSlots = {}
    if #myProps == 0 then return end

    -- ukuran tubuh dari rata-rata prop
    local sumY, sumX = 0, 0
    for _, d in ipairs(myProps) do
        sumY = sumY + d.finalSize.Y
        sumX = sumX + d.finalSize.X
    end
    local avgHeight = sumY / #myProps
    local avgWidth  = sumX / #myProps

    -- bodyHeight = tinggi orang (kaki -> kepala) dalam stud
    -- bodyWidth  = jarak bahu ke bahu dalam stud
    local bodyHeight = (avgHeight * 8 * scale) + (gap * #myProps)
    local bodyWidth  = (avgWidth  * 4 * scale) + (gap * 4)

    -- peta nama slot -> deskripsi skeleton
    local byName = {}
    for _, slot in ipairs(HUMAN_SKELETON) do byName[slot.name] = slot end

    -- isi slot sesuai prioritas sampai prop atau slot habis
    local used = 0
    for _, slotName in ipairs(PRIORITY_ORDER) do
        if used >= #myProps then break end
        used += 1
        local data = myProps[used]
        local slot = byName[slotName]
        if slot then
            local localPos = Vector3.new(
                slot.x * bodyWidth,
                slot.y * bodyHeight,
                0
            )
            local localRot = CFrame.Angles(0, 0, math.rad(slot.rotZ))
            table.insert(assignedSlots, {
                data = data,
                name = slotName,
                localPos = localPos,
                localRot = localRot,
            })
        end
    end

    info.Text = string.format(
        "Prop: %d | Slot terisi: %d | Tinggi: %.1f",
        #myProps, #assignedSlots, bodyHeight
    )
end

--====================================================
-- SUSUN JADI ORANG (mengikuti player)
--====================================================
local function stopLayout()
    layoutRunning = false
    layoutToken += 1
    setStatus("Layout dihentikan.")
end

local function startLayout()
    if layoutRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end

    local scale = math.clamp(tonumber(scaleBox.Text) or 2, 0.5, 10)
    local gap   = math.clamp(tonumber(gapBox.Text) or 0.5, 0, 10)
    local dist  = math.clamp(tonumber(distBox.Text) or 8, 2, 60)

    assignSlots(scale, gap)
    if #assignedSlots == 0 then
        setStatus("Slot tubuh kosong. Butuh minimal 1 prop.")
        return
    end

    layoutRunning = true
    layoutToken += 1
    local myToken = layoutToken
    setStatus(string.format(
        "Menyusun %d prop jadi orang...", #assignedSlots
    ))

    listen(RunService.Heartbeat:Connect(function()
        if not layoutRunning or layoutToken ~= myToken then return end
        if not gui.Parent then stopLayout() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local back = root.CFrame.LookVector * -dist
        local centerPos = root.Position + back
        local centerCF = CFrame.new(centerPos, centerPos + root.CFrame.LookVector)

        local okCount, errCount = 0, 0
        for _, slot in ipairs(assignedSlots) do
            local data = slot.data
            local remote = data.remote
            if remote and remote.Parent and remote:IsA("RemoteFunction") then
                local worldPos = centerCF * slot.localPos
                local goalCF = CFrame.new(worldPos)
                    * centerCF.Rotation
                    * slot.localRot
                    * data.standRotation

                local ok = pcall(function()
                    remote:InvokeServer(goalCF)
                end)
                if ok then okCount += 1 else errCount += 1 end
            else
                errCount += 1
            end
        end

        setStatus(string.format(
            "Orang ON | OK: %d | Err: %d",
            okCount, errCount
        ))
    end))
end

