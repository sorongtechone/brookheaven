--====================================================
-- DRAG
--====================================================
local dragging = false
local dragStart
local startPos
listen(header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end))
listen(UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end))

listen(closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end))

gui.Destroying:Connect(function()
    followRunning = false
    attackRunning = false
    followToken += 1
    for _, c in ipairs(propConnections) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(connections) do
        if c.Connected then c:Disconnect() end
    end
    table.clear(connections)
end)

