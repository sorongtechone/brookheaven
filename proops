local HUMAN_SKELETON = buildHumanSkeleton()

--====================================================
-- ASSIGN SLOT
--====================================================
local PRIORITY_ORDER = {
    "Badan Bawah", "Badan Tengah", "Badan Atas",
    "Kepala", "Leher",
    "Tangan Kiri 1", "Tangan Kanan 1",
    "Tangan Kiri 2", "Tangan Kanan 2",
    "Tangan Kiri 3", "Tangan Kanan 3",
    "Kaki Kiri 1", "Kaki Kanan 1",
    "Kaki Kiri 2", "Kaki Kanan 2",
}

local function assignSlots(scale, gap)
    assignedSlots = {}
    if #myProps == 0 then return end

    local sumY = 0
    for _, d in ipairs(myProps) do sumY = sumY + d.finalSize.Y end
    local avgHeight = sumY / #myProps
    local bodyHeight = avgHeight * 8 * scale

    local byName = {}
    for _, slot in ipairs(HUMAN_SKELETON) do byName[slot.name] = slot end

    local ordered = {}
    for _, slotName in ipairs(PRIORITY_ORDER) do
        if #ordered >= #myProps then break end
        if byName[slotName] then
            table.insert(ordered, slotName)
        end
    end

    local result = {}

    ------------------------------------------------
    -- TORSO: berantai vertikal dari pinggul ke atas
    ------------------------------------------------
    local torsoSlots = {}
    for i, name in ipairs(ordered) do
        if byName[name].chain == "torso" then
            table.insert(torsoSlots, { name = name, data = myProps[i] })
        end
    end

    local torsoBaseY = 0.35 * bodyHeight
    local cursorY = torsoBaseY

    -- susun dari bawah ke atas
    for idx = #torsoSlots, 1, -1 do
        local entry = torsoSlots[idx]
        local h = entry.data.finalSize.Y * scale
        result[entry.name] = {
            data = entry.data,
            localPos = Vector3.new(0, cursorY + h * 0.5, 0),
            localRot = CFrame.new(),
        }
        cursorY = cursorY + h + gap
    end

    -- ==== BAHU: turun satu tingkat prop dari puncak torso ====
    -- cursorY sekarang = ujung atas torso (setelah + gap).
    -- Pangkal prop torso teratas berada di (cursorY - gap - topTorsoH).
    -- Letakkan bahu di titik itu supaya sejajar pangkal kepala,
    -- bukan sejajar ujung kepala.
    local topTorsoH = 0
    if #torsoSlots > 0 then
        topTorsoH = torsoSlots[1].data.finalSize.Y * scale
    end
    local shoulderY = cursorY - gap - topTorsoH
    local shoulderX = 0.35 * bodyHeight * 0.25

    local function buildArm(prefix, startX, startY, angleList)
        local armSlots = {}
        for i, name in ipairs(ordered) do
            if name:sub(1, #prefix) == prefix then
                table.insert(armSlots, { name = name, data = myProps[i] })
            end
        end
        table.sort(armSlots, function(a, b)
            local na = tonumber(a.name:match("(%d+)$")) or 0
            local nb = tonumber(b.name:match("(%d+)$")) or 0
            return na < nb
        end)

        local baseX = startX
        local baseY = startY
        for idx, entry in ipairs(armSlots) do
            local len = entry.data.finalSize.Y * scale
            local angle = angleList[idx] or 0
            local dir = dirFromAngle(angle)

            local centerX = baseX + dir.X * len * 0.5
            local centerY = baseY + dir.Y * len * 0.5
            local rot = CFrame.Angles(0, 0, math.rad(-angle))

            result[entry.name] = {
                data = entry.data,
                localPos = Vector3.new(centerX, centerY, 0),
                localRot = rot,
            }

            baseX = baseX + dir.X * (len + gap)
            baseY = baseY + dir.Y * (len + gap)
        end
    end

    buildArm("Tangan Kiri",  -shoulderX, shoulderY, { 15, 30, 45 })
    buildArm("Tangan Kanan",  shoulderX, shoulderY, { -15, -30, -45 })

    ------------------------------------------------
    -- KAKI: berantai dari pinggul ke bawah
    ------------------------------------------------
    local hipX = 0.18 * bodyHeight * 0.25
    local hipY = torsoBaseY

    local function buildLeg(prefix, startX, startY)
        local legSlots = {}
        for i, name in ipairs(ordered) do
            if name:sub(1, #prefix) == prefix then
                table.insert(legSlots, { name = name, data = myProps[i] })
            end
        end
        table.sort(legSlots, function(a, b)
            local na = tonumber(a.name:match("(%d+)$")) or 0
            local nb = tonumber(b.name:match("(%d+)$")) or 0
            return na < nb
        end)

        local baseX = startX
        local baseY = startY
        for idx, entry in ipairs(legSlots) do
            local len = entry.data.finalSize.Y * scale
            local dir = Vector3.new(0, -1, 0)

            local centerX = baseX + dir.X * len * 0.5
            local centerY = baseY + dir.Y * len * 0.5

            result[entry.name] = {
                data = entry.data,
                localPos = Vector3.new(centerX, centerY, 0),
                localRot = CFrame.new(),
            }

            baseX = baseX + dir.X * (len + gap)
            baseY = baseY + dir.Y * (len + gap)
        end
    end

    buildLeg("Kaki Kiri",  -hipX, hipY)
    buildLeg("Kaki Kanan",  hipX, hipY)

    ------------------------------------------------
    -- Kumpulkan hasil ke assignedSlots
    ------------------------------------------------
    for _, slotName in ipairs(PRIORITY_ORDER) do
        local entry = result[slotName]
        if entry then
            table.insert(assignedSlots, {
                data = entry.data,
                name = slotName,
                localPos = entry.localPos,
                localRot = entry.localRot,
            })
        end
    end

    info.Text = string.format(
        "Prop: %d | Slot terisi: %d | Tinggi: %.1f",
        #myProps, #assignedSlots, bodyHeight
    )
end

--====================================================
-- SUSUN JADI ORANG (mengikuti player)
--====================================================
local function stopLayout()
    layoutRunning = false
    layoutToken += 1
    setStatus("Layout dihentikan.")
end

local function startLayout()
    if layoutRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end

    local scale = math.clamp(tonumber(scaleBox.Text) or 2, 0.5, 10)
    local gap   = math.clamp(tonumber(gapBox.Text) or 0, 0, 10)
    local dist  = math.clamp(tonumber(distBox.Text) or 8, 2, 60)

    assignSlots(scale, gap)
    if #assignedSlots == 0 then
        setStatus("Slot tubuh kosong. Butuh minimal 1 prop.")
        return
    end

    layoutRunning = true
    layoutToken += 1
    local myToken = layoutToken
    setStatus(string.format(
        "Menyusun %d prop jadi orang...", #assignedSlots
    ))

    listen(RunService.Heartbeat:Connect(function()
        if not layoutRunning or layoutToken ~= myToken then return end
        if not gui.Parent then stopLayout() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local back = root.CFrame.LookVector * -dist
        local centerPos = root.Position + back
        local centerCF = CFrame.new(centerPos, centerPos + root.CFrame.LookVector)

        local okCount, errCount = 0, 0
        for _, slot in ipairs(assignedSlots) do
            local data = slot.data
            local remote = data.remote
            if remote and remote.Parent and remote:IsA("RemoteFunction") then
                local worldPos = centerCF * slot.localPos
                local goalCF = CFrame.new(worldPos)
                    * centerCF.Rotation
                    * slot.localRot
                    * data.standRotation

                local ok = pcall(function()
                    remote:InvokeServer(goalCF)
                end)
                if ok then okCount += 1 else errCount += 1 end
            else
                errCount += 1
            end
        end

        setStatus(string.format(
            "Orang ON | OK: %d | Err: %d",
            okCount, errCount
        ))
    end))
end

