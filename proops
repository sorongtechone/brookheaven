gui.Destroying:Connect(function()
    followRunning = false
    followToken += 1
    for _, c in ipairs(propConnections) do
        pcall(function() c:Disconnect() end)
    end
    for _, c in ipairs(connections) do
        if c.Connected then c:Disconnect() end
    end
    table.clear(connections)
end)

