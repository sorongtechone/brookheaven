-- Hasil pengukuran
local maxPropSize = 1     -- ukuran terbesar (studs) dari semua prop
local avgPropSize = 1     -- rata-rata ukuran
local spaceUnit = 1       -- spasi dasar hasil ukur (dipakai skeleton)

--====================================================
-- PENGUKURAN PROP
--====================================================
local function measureObject(obj)
    -- return Vector3 ukuran (X, Y, Z)
    local ok, size = pcall(function()
        if obj:IsA("Model") then
            local _, sz = obj:GetBoundingBox()
            return sz
        elseif obj:IsA("BasePart") then
            return obj.Size
        end
        return Vector3.new(1, 1, 1)
    end)
    if ok and typeof(size) == "Vector3" then
        return size
    end
    return Vector3.new(1, 1, 1)
end

local function measureAllProps()
    local maxSize = 0
    local sum = 0
    local count = 0
    local maxDim = 0
    for _, data in ipairs(myProps) do
        local sz = measureObject(data.object)
        data.size = sz
        local biggest = math.max(sz.X, sz.Y, sz.Z)
        maxSize = math.max(maxSize, biggest)
        sum += biggest
        count += 1
    end
    maxPropSize = maxSize > 0 and maxSize or 1
    avgPropSize = count > 0 and (sum / count) or 1
    -- spasi dasar: pakai ukuran rata-rata (biar prop kecil tidak terlalu jauh)
    -- dikali 0.6 supaya sedikit menempel tapi tidak tumpang tindih
    spaceUnit = math.max(avgPropSize * 0.6, 1)
    measureInfo.Text = string.format("Terbesar: %.1f | Rata²: %.1f | Spasi: %.1f",
        maxPropSize, avgPropSize, spaceUnit)
end

--====================================================
-- SCAN PROP
--====================================================
local function scanMyProps()
    myProps = {}
    assignedSlots = {}
    local seen = {}
    local username = localPlayer.Name:lower()
    local ownedName = "prop" .. username
    local folders = {
        workspace:FindFirstChild("WorkspaceCom"),
        workspace:FindFirstChild("bh_Props"),
        workspace:FindFirstChild("Props"),
    }

    local function inspect(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
        if seen[obj] then return end
        local name = obj.Name:lower()
        local remote = obj:FindFirstChild("SetCurrentCFrame", true)
        if not remote or not remote:IsA("RemoteFunction") then return end
        local ownerMatch = name == ownedName
            or (name:find("prop", 1, true) and name:find(username, 1, true))
        if not ownerMatch then return end
        seen[obj] = true
        table.insert(myProps, { object = obj, remote = remote })
    end

    for _, folder in ipairs(folders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do inspect(obj) end
            inspect(folder)
        end
    end

    table.sort(myProps, function(a, b)
        return a.object.Name:lower() < b.object.Name:lower()
    end)

    -- UKUR SEMUA PROP DULU
    measureAllProps()

    -- tampilkan list dengan ukuran
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end
    for i, data in ipairs(myProps) do
        local sz = data.size or Vector3.new(1,1,1)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -8, 0, 22)
        lbl.LayoutOrder = i
        lbl.BackgroundColor3 = Color3.fromRGB(50, 54, 73)
        lbl.Text = string.format(" %d. %s  [%.1f×%.1f×%.1f]",
            i, data.object.Name, sz.X, sz.Y, sz.Z)
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextSize = 10
        lbl.Font = Enum.Font.Gotham
        lbl.Parent = listFrame
        round(lbl, 4)
    end
    listFrame.CanvasSize = UDim2.fromOffset(0, #myProps * 25 + 6)
    info.Text = "Prop: " .. #myProps .. " | Slot: 0/9"
    setStatus(#myProps > 0
        and ("Ditemukan " .. #myProps .. " prop & diukur. Atur skala lalu FOLLOW.")
        or "Tidak ada prop milikmu. Spawn prop manual dahulu.")
end

