    -- Badan (dari bawah ke atas)
    table.insert(S, { name = "Badan Bawah", x = 0,     y = 0.55, rotZ = 0,   rotX = 0 })
    table.insert(S, { name = "Badan Tengah",x = 0,     y = 0.70, rotZ = 0,   rotX = 0 })
    table.insert(S, { name = "Badan Atas",  x = 0,     y = 0.82, rotZ = 0,   rotX = 0 })
    -- Bahu kiri/kanan
    table.insert(S, { name = "Bahu Kiri",   x = -0.30, y = 0.82, rotZ =  15, rotX = 0 })
    table.insert(S, { name = "Bahu Kanan",  x =  0.30, y = 0.82, rotZ = -15, rotX = 0 })
    -- Lengan atas
    table.insert(S, { name = "Lengan Atas Kiri",  x = -0.42, y = 0.70, rotZ =  40, rotX = 0 })
    table.insert(S, { name = "Lengan Atas Kanan", x =  0.42, y = 0.70, rotZ = -40, rotX = 0 })
    -- Lengan bawah
    table.insert(S, { name = "Lengan Bawah Kiri",  x = -0.52, y = 0.55, rotZ =  70, rotX = 0 })
    table.insert(S, { name = "Lengan Bawah Kanan", x =  0.52, y = 0.55, rotZ = -70, rotX = 0 })
    -- Tangan
    table.insert(S, { name = "Tangan Kiri",  x = -0.58, y = 0.42, rotZ =  85, rotX = 0 })
    table.insert(S, { name = "Tangan Kanan", x =  0.58, y = 0.42, rotZ = -85, rotX = 0 })
    -- Pinggul
    table.insert(S, { name = "Pinggul Kiri",  x = -0.18, y = 0.48, rotZ = 0, rotX = 0 })
    table.insert(S, { name = "Pinggul Kanan", x =  0.18, y = 0.48, rotZ = 0, rotX = 0 })
