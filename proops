--====================================================
-- UKUR PROP
-- Ukuran diambil dari bounding box (Model: GetExtentsSize,
-- BasePart: Size). Untuk Model, dihitung juga center-nya
-- dari GetBoundingBox supaya offset tepat.
--====================================================
local function measureProp(obj)
    if obj:IsA("Model") then
        local ok, cf, size = pcall(function()
            return obj:GetBoundingBox()
        end)
        if ok and cf and size then
            return size, cf.Position
        end
        -- fallback: hitung manual dari semua part
        local minV = Vector3.new(math.huge, math.huge, math.huge)
        local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, part in ipairs(obj:GetDescendants()) do
            if part:IsA("BasePart") then
                local p = part.Position
                local s = part.Size * 0.5
                minV = Vector3.new(
                    math.min(minV.X, p.X - s.X),
                    math.min(minV.Y, p.Y - s.Y),
                    math.min(minV.Z, p.Z - s.Z)
                )
                maxV = Vector3.new(
                    math.max(maxV.X, p.X + s.X),
                    math.max(maxV.Y, p.Y + s.Y),
                    math.max(maxV.Z, p.Z + s.Z)
                )
            end
        end
        if minV.X == math.huge then return Vector3.zero, obj:GetPivot().Position end
        local size = maxV - minV
        local center = (minV + maxV) * 0.5
        return size, center
    elseif obj:IsA("BasePart") then
        return obj.Size, obj.Position
    end
    return Vector3.zero, Vector3.zero
end

--====================================================
-- SCAN
--====================================================
local function scanMyProps()
    myProps = {}
    local seen = {}
    local username = localPlayer.Name:lower()
    local ownedName = "prop" .. username
    local folders = {
        workspace:FindFirstChild("WorkspaceCom"),
        workspace:FindFirstChild("bh_Props"),
        workspace:FindFirstChild("Props"),
    }

    local function inspect(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
        if seen[obj] then return end
        local name = obj.Name:lower()
        local remote = obj:FindFirstChild("SetCurrentCFrame", true)
        if not remote or not remote:IsA("RemoteFunction") then return end
        local ownerMatch = name == ownedName
            or (name:find("prop", 1, true) and name:find(username, 1, true))
        if not ownerMatch then return end
        seen[obj] = true

        local size, center = measureProp(obj)
        table.insert(myProps, {
            object = obj,
            remote = remote,
            size = size,
            center = center,
        })
    end

    for _, folder in ipairs(folders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do inspect(obj) end
            inspect(folder)
        end
    end

    table.sort(myProps, function(a, b)
        return a.object.Name:lower() < b.object.Name:lower()
    end)

    -- tampilkan di list
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextLabel") then child:Destroy() end
    end

    local totalWidth = 0
    for i, data in ipairs(myProps) do
        local s = data.size
        totalWidth = totalWidth + s.X
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -8, 0, 34)
        lbl.LayoutOrder = i
        lbl.BackgroundColor3 = Color3.fromRGB(50, 54, 73)
        lbl.Text = string.format(
            " %d. %s\n   X=%.1f Y=%.1f Z=%.1f",
            i, data.object.Name, s.X, s.Y, s.Z
        )
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Top
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.TextSize = 10
        lbl.Font = Enum.Font.Gotham
        lbl.Parent = listFrame
        round(lbl, 4)
    end

    listFrame.CanvasSize = UDim2.fromOffset(0, #myProps * 37 + 6)
    info.Text = string.format("Prop: %d | Total lebar X: %.1f", #myProps, totalWidth)

    if #myProps == 0 then
        setStatus("Tidak ada prop milikmu. Spawn prop manual dahulu.")
    else
        setStatus(string.format(
            "Ditemukan %d prop. Tekan SUSUN BERJEJER untuk menata.",
            #myProps
        ))
    end
end

listen(scanBtn.MouseButton1Click:Connect(scanMyProps))

--====================================================
-- SUSUN BERJEJER
-- Prop diletakkan berjejer di depan player (sumbu X lokal),
-- dengan jarak = gap, dihitung dari ukuran asli tiap prop.
--====================================================
local function stopLayout()
    layoutRunning = false
    layoutToken += 1
    setStatus("Layout dihentikan.")
end

local function startLayout()
    if layoutRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end

    local gap = math.clamp(tonumber(gapBox.Text) or 2, 0, 50)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 0, -20, 50)

    layoutRunning = true
    layoutToken += 1
    local myToken = layoutToken
    setStatus(string.format("Menyusun %d prop berjejer...", #myProps))

    listen(RunService.Heartbeat:Connect(function()
        if not layoutRunning or layoutToken ~= myToken then return end
        if not gui.Parent then stopLayout() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- hitung total lebar termasuk gap
        local totalWidth = 0
        for i, data in ipairs(myProps) do
            totalWidth = totalWidth + data.size.X
            if i < #myProps then totalWidth = totalWidth + gap end
        end

        -- mulai dari kiri
        local cursor = -totalWidth * 0.5
        local baseCF = root.CFrame

        local okCount, errCount = 0, 0
        for _, data in ipairs(myProps) do
            local s = data.size
            local localX = cursor + s.X * 0.5
            local localY = heightOffset + s.Y * 0.5
            local localPos = Vector3.new(localX, localY, -8) -- 8 stud di depan player
            local worldPos = baseCF * localPos

            -- orientasi ikut player (depan player = -Z lokal)
            local goalCF = CFrame.new(worldPos) * baseCF.Rotation

            local ok = pcall(function()
                data.remote:InvokeServer(goalCF)
            end)
            if ok then okCount += 1 else errCount += 1 end

            cursor = cursor + s.X + gap
        end

        setStatus(string.format(
            "Layout ON | OK: %d | Err: %d | total lebar: %.1f",
            okCount, errCount, totalWidth
        ))
    end))
end

listen(layoutBtn.MouseButton1Click:Connect(startLayout))
listen(stopBtn.MouseButton1Click:Connect(stopLayout))

--====================================================
-- DRAG
--====================================================
local dragging = false
local dragStart
local startPos
listen(header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
       or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end))
listen(UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
       or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end))

listen(closeBtn.MouseButton1Click:Connect(function() gui:Destroy() end))

gui.Destroying:Connect(function()
    layoutRunning = false
    layoutToken += 1
    for _, c in ipairs(connections) do
        if c.Connected then c:Disconnect() end
    end
    table.clear(connections)
end)

