    return S
end

local HUMAN_SKELETON = buildHumanSkeleton()

--====================================================
-- ASSIGN SLOT
-- Slot tubuh dipetakan ke prop yang tersedia (urut dari scan).
-- Posisi lokal tiap slot dihitung dari:
--   x * bodyWidth * scale
--   y * bodyHeight * scale
-- Rotasi lokal = rotZ (putar sumbu Z) dan rotX (putar sumbu X).
--====================================================
local function assignSlots(scale, gap)
    assignedSlots = {}
    if #myProps == 0 then return end

    -- ukuran "unit tubuh" = rata-rata finalSize prop
    local sumY, sumX = 0, 0
    for _, d in ipairs(myProps) do
        sumY = sumY + d.finalSize.Y
        sumX = sumX + d.finalSize.X
    end
    local avgHeight = sumY / #myProps
    local avgWidth  = sumX / #myProps

    -- bodyHeight = total tinggi tubuh manusia (kepala-kaki) dalam stud
    -- bodyWidth  = lebar tubuh (bahu ke bahu) dalam stud
    local bodyHeight = avgHeight * 8 * scale   -- 8 "unit" vertikal
    local bodyWidth  = avgWidth  * 4 * scale   -- 4 "unit" horizontal

    -- tambah celah antar prop
    bodyHeight = bodyHeight + gap * #myProps
    bodyWidth  = bodyWidth  + gap * 4

    for i, data in ipairs(myProps) do
        local slot = HUMAN_SKELETON[i]
        if not slot then break end

        local localPos = Vector3.new(
            slot.x * bodyWidth,
            slot.y * bodyHeight,
            0
        )

        local localRot = CFrame.Angles(
            math.rad(slot.rotX),
            0,
            math.rad(slot.rotZ)
        )

        table.insert(assignedSlots, {
            data = data,
            name = slot.name,
            localPos = localPos,
            localRot = localRot,
        })
    end

    info.Text = string.format(
        "Prop: %d | Slot terisi: %d | Tinggi: %.1f",
        #myProps, #assignedSlots, bodyHeight
    )
end

--====================================================
-- SUSUN JADI ORANG (mengikuti player)
--====================================================
local function stopLayout()
    layoutRunning = false
    layoutToken += 1
    setStatus("Layout dihentikan.")
end

local function startLayout()
    if layoutRunning then return end
    if #myProps == 0 then setStatus("Scan prop dulu.") return end

    local scale = math.clamp(tonumber(scaleBox.Text) or 2, 0.5, 10)
    local gap   = math.clamp(tonumber(gapBox.Text) or 0.5, 0, 10)
    local dist  = math.clamp(tonumber(distBox.Text) or 8, 2, 60)

    assignSlots(scale, gap)
    if #assignedSlots == 0 then
        setStatus("Slot tubuh kosong. Butuh minimal 1 prop.")
        return
    end

    layoutRunning = true
    layoutToken += 1
    local myToken = layoutToken
    setStatus(string.format(
        "Menyusun %d prop jadi orang...", #assignedSlots
    ))

    listen(RunService.Heartbeat:Connect(function()
        if not layoutRunning or layoutToken ~= myToken then return end
        if not gui.Parent then stopLayout() return end

        local char = localPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- pusat tubuh di belakang player
        local back = root.CFrame.LookVector * -dist
        local centerPos = root.Position + back
        local centerCF = CFrame.new(centerPos, centerPos + root.CFrame.LookVector)

        local okCount, errCount = 0, 0
        for _, slot in ipairs(assignedSlots) do
            local data = slot.data
            local remote = data.remote
            if remote and remote.Parent and remote:IsA("RemoteFunction") then
                local worldPos = centerCF * slot.localPos
                -- rotasi: pusat -> rotasi lokal slot -> rotasi berdiri prop
                local goalCF = CFrame.new(worldPos)
                    * centerCF.Rotation
                    * slot.localRot
                    * data.standRotation

                local ok = pcall(function()
                    remote:InvokeServer(goalCF)
                end)
                if ok then okCount += 1 else errCount += 1 end
            else
                errCount += 1
            end
        end

        setStatus(string.format(
            "Orang ON | OK: %d | Err: %d",
            okCount, errCount
        ))
    end))
end

