-- BENTUK ORANG (HUMANOID LAYOUT)
-- Proporsi berdasarkan tinggi rata-rata prop.
-- Setiap slot dideskripsikan sebagai:
--   {name, x, y (dalam "unit tubuh"), rotZ, rotX}
-- Lalu posisi dikalikan ukuran tubuh aktual.
-- Tanpa ekor/sayap/tanduk.
--====================================================
local function buildHumanSkeleton()
