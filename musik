    local name = song[1]
    local id = song[2]

    local button = createButton(
        songList,
        "  🎵 " .. index .. ". " .. name,
        UDim2.new(1, -5, 0, 35),
        UDim2.new(),
        Color3.fromRGB(52, 52, 62)
    )

    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 12
    button:SetAttribute("SongID", id)

    table.insert(songButtons, button)

    button.MouseButton1Click:Connect(function()
        input.Text = id
        playMusic(id)
        refreshSongs()
    end)
end

