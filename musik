-- MUSIC CONTROL

local currentSong = nil

local function stopMusic()
    for _, item in ipairs(remotes) do
        pcall(function()
            item[1]:FireServer(item[2], "0", true)
        end)
    end

    currentSong = nil
end

local function sendMusic(id)
    for _, item in ipairs(remotes) do
        pcall(function()
            item[1]:FireServer(item[2], "0", true)
        end)
    end

    task.wait(0.25)

    for _, item in ipairs(remotes) do
        pcall(function()
            item[1]:FireServer(item[2], id, true)
        end)
    end
end

local function playMusic(id)
    if currentSong == id then
        stopMusic()
        return false
    end

    currentSong = id
    task.spawn(sendMusic, id)
    return true
end

