local songButtons = {}

local function refreshSongs()
    for _, button in ipairs(songButtons) do
        button.BackgroundColor3 =
            button:GetAttribute("SongID") == currentSong
            and Color3.fromRGB(35, 140, 80)
            or Color3.fromRGB(52, 52, 62)
    end
end

