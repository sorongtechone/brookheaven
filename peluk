--====================================================
-- MOTOR6D HELPER
-- Menyimpan nilai asli Motor6D supaya bisa di-reset.
--====================================================
local origMotors = {}

local function grabMotor(char, motorName)
    local torso = char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("LowerTorso")
    local motor = torso and torso:FindFirstChild(motorName)
    if motor and motor:IsA("Motor6D") then
        if not origMotors[motor] then
            origMotors[motor] = {
                C0 = motor.C0,
                C1 = motor.C1,
                Transform = motor.Transform,
            }
        end
        return motor
    end
    return nil
end

local function resetAllMotors()
    for motor, data in pairs(origMotors) do
        if motor and motor.Parent then
            motor.C0 = data.C0
            motor.C1 = data.C1
            motor.Transform = data.Transform
        end
    end
    origMotors = {}
end

--====================================================
-- ANIMASI PELUK
-- Pose target (radian):
--   RightShoulder : lengan kiri/kanan terangkat & menutup ke depan
--   LeftShoulder  : sama, sisi sebaliknya
--   Neck          : kepala agak menunduk sedikit
--   Waist         : badan agak membungkuk ke depan
-- Lalu TweenService menginterpolasi ke pose itu (open -> close).
--====================================================
local function getCharacterMotors(char)
    local torso = char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
    if not torso then return nil end

    return {
        rightShoulder = torso:FindFirstChild("RightShoulder"),
        leftShoulder  = torso:FindFirstChild("LeftShoulder"),
        neck          = torso:FindFirstChild("Neck"),
        waist         = char:FindFirstChild("UpperTorso")
                        and char.UpperTorso:FindFirstChild("Waist")
                        or torso:FindFirstChild("Waist"),
    }
end

-- Konversi rotasi sederhana ke CFrame target relatif terhadap C0 asli
local function makeHugPose()
    return {
        rightShoulder = CFrame.Angles(0, math.rad(-75), math.rad(-40)),
        leftShoulder  = CFrame.Angles(0, math.rad(75),  math.rad(40)),
        neck          = CFrame.Angles(math.rad(15), 0, 0),
        waist         = CFrame.Angles(math.rad(8), 0, 0),
    }
end

local function makeOpenPose()
    return {
        rightShoulder = CFrame.Angles(0, math.rad(-20), math.rad(-70)),
        leftShoulder  = CFrame.Angles(0, math.rad(20),  math.rad(70)),
        neck          = CFrame.Angles(math.rad(-5), 0, 0),
        waist         = CFrame.Angles(0, 0, 0),
    }
end

local function tweenMotor(motor, targetCF, duration)
    if not motor or not motor.Parent then return end
    local orig = origMotors[motor]
    if not orig then return end
    local goalC0 = orig.C0 * targetCF
    local tw = TweenService:Create(
        motor,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { C0 = goalC0 }
    )
    tw:Play()
    return tw
end

local hugging = false
local hugToken = 0

local function playHug()
    if hugging then return end
    local char = localPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- simpan orientasi awal & matikan kontrol gerak
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local startCFrame = root.CFrame
    local wasPlatform = humanoid.PlatformStand
    humanoid.PlatformStand = true

    hugging = true
    hugToken += 1
    local myToken = hugToken

    -- ambil motor & simpan nilai aslinya
    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local motors = {
        rs = grabMotor(char, "RightShoulder"),
        ls = grabMotor(char, "LeftShoulder"),
        neck = grabMotor(char, "Neck"),
        waist = grabMotor(char, "Waist"),
    }
    if not motors.rs or not motors.ls then
        setStatusSafe("Karakter bukan R6/R15 standar.")
        humanoid.PlatformStand = wasPlatform
        hugging = false
        return
    end

    -- tahap 1: buka tangan (0.35s)
    local open = makeOpenPose()
    tweenMotor(motors.rs, open.rightShoulder, 0.35)
    tweenMotor(motors.ls, open.leftShoulder, 0.35)
    tweenMotor(motors.neck, open.neck, 0.35)
    tweenMotor(motors.waist, open.waist, 0.35)

    task.wait(0.4)
    if not hugging or hugToken ~= myToken then
        humanoid.PlatformStand = wasPlatform
        return
    end

    -- tahap 2: tutup tangan (memeluk) (0.45s)
    local hug = makeHugPose()
    local tws = {
        tweenMotor(motors.rs, hug.rightShoulder, 0.45),
        tweenMotor(motors.ls, hug.leftShoulder, 0.45),
        tweenMotor(motors.neck, hug.neck, 0.45),
        tweenMotor(motors.waist, hug.waist, 0.45),
    }

    -- tunggu selesai
    task.wait(0.5)
    if not hugging or hugToken ~= myToken then
        humanoid.PlatformStand = wasPlatform
        return
    end

    -- tahan pose peluk ~1.5 detik
    task.wait(1.5)
    if not hugging or hugToken ~= myToken then
        humanoid.PlatformStand = wasPlatform
        return
    end

    -- tahap 3: kembali ke pose normal (0.5s)
    local resetPose = {
        rightShoulder = CFrame.new(),
        leftShoulder  = CFrame.new(),
        neck          = CFrame.new(),
        waist         = CFrame.new(),
    }
    tweenMotor(motors.rs, resetPose.rightShoulder, 0.5)
    tweenMotor(motors.ls, resetPose.leftShoulder, 0.5)
    tweenMotor(motors.neck, resetPose.neck, 0.5)
    tweenMotor(motors.waist, resetPose.waist, 0.5)

    task.wait(0.6)
    humanoid.PlatformStand = wasPlatform
    hugging = false
    -- kembalikan posisi karakter agar tidak bergeser
    if root and root.Parent then
        root.CFrame = startCFrame
    end
    resetAllMotors()
end

