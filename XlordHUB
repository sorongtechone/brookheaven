local function stopSpam()
    musicSpamEnabled = false
    musicSpamToggle.Text = "AUDIO MELEDAK KE SEMUA: OFF"
    musicSpamToggle.BackgroundColor3 = COLORS.gray
    if spamThread then
        pcall(function() task.cancel(spamThread) end)
        spamThread = nil
    end
    stopLocalSound()
    musicNotify("Spam audio dihentikan")
end

local function startSpam()
    musicSpamEnabled = true
    musicSpamToggle.Text = "AUDIO MELEDAK KE SEMUA: ON"
    musicSpamToggle.BackgroundColor3 = COLORS.green
    local id = selectedAudioID or SPAM_ID_DEFAULT
    musicNotify("Spam audio ON | ID " .. tostring(id))
    spamThread = task.spawn(function()
        while musicSpamEnabled and gui.Parent do
            fireServerAudio(workspace, id)
            -- client-side juga
            local char = localPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local s = Instance.new("Sound")
                s.SoundId = "rbxassetid://" .. tostring(id)
                s.Volume = 1
                s.Parent = root
                s:Play()
                task.delay(1, function() pcall(function() if s.Parent then s:Destroy() end end) end)
            end
            task.wait(0.03)
        end
    end)
end

