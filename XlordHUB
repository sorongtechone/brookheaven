local lookToken = 0
local lookConnection = nil

local function stopLook(message)
    lookToken = lookToken + 1
    lookEnabled = false
    if lookConnection then
        pcall(function() lookConnection:Disconnect() end)
        lookConnection = nil
    end
    local myChar = localPlayer.Character
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if myHum and workspace.CurrentCamera then
        workspace.CurrentCamera.CameraSubject = myHum
    end
    lookButton.Text = "LIHAT: OFF"
    lookButton.BackgroundColor3 = COLORS.gray
    if message then setStatus(message) end
end

local function startLook()
    local target = selectedPlayer
    if not target or target.Parent ~= Players then
        setStatus("Pilih target terlebih dahulu")
        return
    end
    local tChar = target.Character
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    if not tHum then
        setStatus("Target belum siap")
        return
    end

    lookEnabled = true
    lookToken = lookToken + 1
    local myToken = lookToken
    lookButton.Text = "LIHAT: ON"
    lookButton.BackgroundColor3 = COLORS.green
    setStatus("Melihat @" .. target.Name)

    local camera = workspace.CurrentCamera
    camera.CameraSubject = tHum

    -- Jaga-jaga kalau target respawn / ganti humanoid
    lookConnection = RunService.Heartbeat:Connect(function()
        if lookToken ~= myToken or not lookEnabled then return end
        if gui.Parent == nil then stopLook(nil); return end
        if selectedPlayer ~= target then stopLook("Target diganti"); return end
        if target.Parent ~= Players then stopLook("Target keluar server"); return end
        local c = target.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not h then return end
        if workspace.CurrentCamera.CameraSubject ~= h then
            workspace.CurrentCamera.CameraSubject = h
        end
    end)
end

listen(lookButton.MouseButton1Click:Connect(function()
    if lookEnabled then
        stopLook("Lihat player OFF")
    else
        startLook()
    end
end))

