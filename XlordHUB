local antiSitEnabled = false
local antiSitHumanoidConnection = nil
local antiSitCharacterConnection = nil

local function monitorAntiSitCharacter(character)
    if not antiSitEnabled or not character then return end
    if antiSitHumanoidConnection then
        antiSitHumanoidConnection:Disconnect()
        antiSitHumanoidConnection = nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
        or character:WaitForChild("Humanoid", 5)
    if not humanoid or not antiSitEnabled then return end
    antiSitHumanoidConnection =
        humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
            if antiSitEnabled and humanoid.Parent and humanoid.Sit then
                humanoid.Sit = false
            end
        end)
    if humanoid.Sit then humanoid.Sit = false end
end

local function setAntiSit(enabled)
    antiSitEnabled = enabled
    if not enabled then
        if antiSitHumanoidConnection then
            antiSitHumanoidConnection:Disconnect(); antiSitHumanoidConnection = nil
        end
        if antiSitCharacterConnection then
            antiSitCharacterConnection:Disconnect(); antiSitCharacterConnection = nil
        end
        return
    end
    monitorAntiSitCharacter(Players.LocalPlayer.Character)
    if not antiSitCharacterConnection then
        antiSitCharacterConnection =
            Players.LocalPlayer.CharacterAdded:Connect(function(character)
                task.defer(function() monitorAntiSitCharacter(character) end)
            end)
    end
end

