local width, height = 320, 490
local MIN_WIDTH, MIN_HEIGHT = 320, 365
local MAX_WIDTH, MAX_HEIGHT = 420, 640
local ROW_HEIGHT, ROW_GAP, LIST_PADDING = 38, 6, 6
local listCount = 0
local canvasRevision = 0

local function viewportSize()
    local camera = workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(800, 600)
end

local function updateCanvas(resetPosition)
    if not gui.Parent then return end
    canvasRevision = canvasRevision + 1
    local revision = canvasRevision
    local rowsHeight = listCount * ROW_HEIGHT
    local gapsHeight = math.max(0, listCount - 1) * ROW_GAP
    local canvasHeight = rowsHeight + gapsHeight + LIST_PADDING * 2 + 28
    scroll.CanvasSize = UDim2.fromOffset(0, canvasHeight)
    if resetPosition then scroll.CanvasPosition = Vector2.zero end
    task.spawn(function()
        RunService.Heartbeat:Wait()
        if not gui.Parent or revision ~= canvasRevision then return end
        scroll.CanvasSize = UDim2.fromOffset(0, canvasHeight)
        local maxY = math.max(0, canvasHeight - scroll.AbsoluteWindowSize.Y)
        scroll.CanvasPosition = Vector2.new(0, math.clamp(scroll.CanvasPosition.Y, 0, maxY))
    end)
end

local function ensureOnScreen(object)
    local view = viewportSize()
    if object == main then
        local halfW, halfH = width / 2, height / 2
        local pos = main.AbsolutePosition
        local centerX = math.clamp(pos.X + halfW, halfW, math.max(halfW, view.X - halfW))
        local centerY = math.clamp(pos.Y + halfH, halfH, math.max(halfH, view.Y - halfH))
        main.Position = UDim2.fromOffset(centerX, centerY)
    else
        local pos = floating.AbsolutePosition
        local sz = floating.AbsoluteSize
        floating.Position = UDim2.fromOffset(
            math.clamp(pos.X, 0, math.max(0, view.X - sz.X)),
            math.clamp(pos.Y, 0, math.max(0, view.Y - sz.Y))
        )
    end
end

