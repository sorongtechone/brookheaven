    -- Baris 4: status
    status.Position = UDim2.fromOffset(10, row3Y + 32)
    status.Size = UDim2.fromOffset(width - 20, 28)

    updateCanvas(false)
    task.defer(function()
        if gui.Parent and main.Visible then ensureOnScreen(main) end
    end)
end

