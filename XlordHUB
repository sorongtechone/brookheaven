local selectedPlayer

--====================================================
-- TRAMPOLINE V19: NO CAMERA / NO MOUSE / NO CLICK
-- Clone the visual geometry of the genuine trampoline tool
-- and set its position directly beneath the selected target.
-- Client-only visual preview; NO server placement is claimed.
--====================================================
local trampolineBusy = false
local trampolinePreview = nil

local function isTrampolineTool(instance)
    if not instance or not instance:IsA("Tool") then return false end
    local key = instance.Name:lower():gsub("[%s_%-]", "")
    return key:find("trampoline", 1, true) ~= nil
        or key:find("trampolin", 1, true) ~= nil
end

local function findOwnedTrampoline(character, backpack)
    for _, container in ipairs({character, backpack}) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if isTrampolineTool(item) then return item end
            end
        end
    end
    return nil
end

local function getRealTrampoline(character, backpack)
    local tool = findOwnedTrampoline(character, backpack)
    if tool then return tool end
    local folder = ReplicatedStorage:FindFirstChild("RE")
    local remote = folder and folder:FindFirstChild("1Too1l")
    if remote and remote:IsA("RemoteFunction") then
        setStatus("Mengambil item Trampoline asli...")
        local ok, err = pcall(function()
            remote:InvokeServer("PickingTools", "Trampoline")
        end)
        if not ok then warn("[XLORD V19] Gagal mengambil Trampoline:", err) end
    end
    for _ = 1, 25 do
        if not gui.Parent or localPlayer.Character ~= character then return nil end
        tool = findOwnedTrampoline(character, backpack)
        if tool then return tool end
        task.wait(0.1)
    end
    return nil
end

local function getGroundBelowTarget(target)
    local targetCharacter = target and target.Character
    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
    local targetHum = targetCharacter and targetCharacter:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not targetHum or targetHum.Health <= 0 then
        return nil, "Posisi target belum tersedia"
    end

    local feetY = targetRoot.Position.Y - targetHum.HipHeight - targetRoot.Size.Y / 2
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {targetCharacter}
    if localPlayer.Character then table.insert(ignore, localPlayer.Character) end
    if trampolinePreview then table.insert(ignore, trampolinePreview) end
    params.FilterDescendantsInstances = ignore
    params.RespectCanCollide = true

    local origin = Vector3.new(targetRoot.Position.X, feetY + 2.5, targetRoot.Position.Z)
    local hit = workspace:Raycast(origin, Vector3.new(0, -16, 0), params)
    if not hit or hit.Normal.Y < 0.7 then
        return nil, "Tidak ditemukan lantai di bawah target"
    end
    if feetY - hit.Position.Y > 5 then
        return nil, "Target terlalu jauh dari lantai"
    end
    if hit.Position.Y < workspace.FallenPartsDestroyHeight + 30 then
        return nil, "Target terlalu dekat dengan void"
    end
    return hit.Position, nil
end

local function makeTrampolineVisual(tool)
    local model = Instance.new("Model")
    model.Name = "XLORD_Trampoline_LocalPreview"
    local count = 0
    local reference = tool:FindFirstChild("Handle")
    if not reference or not reference:IsA("BasePart") then
        reference = tool:FindFirstChildWhichIsA("BasePart", true)
    end
    if not reference then
        model:Destroy()
        return nil, "Item asli tidak memiliki geometri yang bisa ditampilkan"
    end

    local origin = CFrame.new(0, 20, 0)
    for _, original in ipairs(tool:GetDescendants()) do
        if original:IsA("BasePart") and count < 80 then
            local ok, cloned = pcall(function() return original:Clone() end)
            if ok and cloned then
                -- Keep only visible geometry, no scripts/welds/input behavior.
                for _, child in ipairs(cloned:GetDescendants()) do
                    if child:IsA("Script") or child:IsA("LocalScript")
                        or child:IsA("ModuleScript") or child:IsA("JointInstance")
                        or child:IsA("Constraint") or child:IsA("BodyMover") then
                        child:Destroy()
                    end
                end
                cloned.Anchored = true
                cloned.CanCollide = false
                cloned.CanTouch = false
                cloned.CanQuery = false
                cloned.AssemblyLinearVelocity = Vector3.zero
                cloned.AssemblyAngularVelocity = Vector3.zero
                local relative = reference.CFrame:ToObjectSpace(original.CFrame)
                if relative.Position.Magnitude > 30 then
                    relative = CFrame.identity
                end
                cloned.CFrame = origin * relative
                cloned.Parent = model
                count = count + 1
            end
        end
    end

    if count == 0 then
        model:Destroy()
        return nil, "Geometri trampoline tidak bisa dikloning"
    end
    model.Parent = workspace
    return model, nil
end

local function placeNoClickTrampoline()
    if trampolineBusy then return end
    local target = selectedPlayer
    if not target or target.Parent ~= Players then
        setStatus("Pilih pemain terlebih dahulu")
        return
    end
    local firstPoint, reason = getGroundBelowTarget(target)
    if not firstPoint then
        setStatus(reason)
        return
    end

    trampolineBusy = true
    task.spawn(function()
        local character = localPlayer.Character
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        if not character or not backpack then
            setStatus("Karakter / Backpack tidak tersedia")
            trampolineBusy = false
            return
        end

        local tool = getRealTrampoline(character, backpack)
        if not gui.Parent then trampolineBusy = false; return end
        if not tool then
            setStatus("Item Trampoline asli tidak ditemukan")
            trampolineBusy = false
            return
        end

        local point, why = getGroundBelowTarget(target)
        if not point then
            setStatus(why)
            trampolineBusy = false
            return
        end

        -- Direct geometric placement; NEVER sends mouse/keyboard input.
        local visual, err = makeTrampolineVisual(tool)
        if not visual then
            setStatus(err)
            trampolineBusy = false
            return
        end
        local center, size = visual:GetBoundingBox()
        local bottomY = center.Position.Y - size.Y / 2
        local move = Vector3.new(
            point.X - center.Position.X,
            point.Y + 0.08 - bottomY,
            point.Z - center.Position.Z
        )
        visual:PivotTo(visual:GetPivot() + move)

        if trampolinePreview then trampolinePreview:Destroy() end
        trampolinePreview = visual
        setStatus(string.format(
            "Preview lokal X:%.1f Y:%.1f Z:%.1f (bukan prop server)",
            point.X, point.Y, point.Z
        ))
        print("[XLORD V19] No-click local trampoline preview below @" .. target.Name, point)
        trampolineBusy = false
    end)
end

listen(trampolineButton.MouseButton1Click:Connect(placeNoClickTrampoline))

