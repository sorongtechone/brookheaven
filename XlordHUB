--====================================================
-- V21: GENUINE BROOKHAVEN TRAMPOLINE TOOL EXPERIMENT
-- NO visual clone, NO VirtualInputManager, NO mouse click.
-- The Tool is fetched from the game; Tool:Activate is attempted
-- near the chosen target. Exact SERVER placement is unverified.
--====================================================
local trampolinePreview = nil -- keep cleanup in the shared GUI compatible
local trampolineBusy = false

local function isGenuineTrampoline(obj)
    if not obj or not obj:IsA("Tool") then return false end
    local n = obj.Name:lower():gsub("[%s_%-]", "")
    return n:find("trampoline", 1, true) ~= nil
        or n:find("trampolin", 1, true) ~= nil
end

local function findTrampoline(char, backpack)
    for _, container in ipairs({char, backpack}) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if isGenuineTrampoline(obj) then return obj end
            end
        end
    end
    return nil
end

local function fetchTrampoline(char, backpack)
    local tool = findTrampoline(char, backpack)
    if tool then return tool end
    local re = ReplicatedStorage:FindFirstChild("RE")
    local pickup = re and re:FindFirstChild("1Too1l")
    if not pickup or not pickup:IsA("RemoteFunction") then
        return nil, "Remote pengambilan item tidak tersedia"
    end
    setStatus("Mengambil trampoline merah asli...")
    local ok, err = pcall(function()
        pickup:InvokeServer("PickingTools", "Trampoline")
    end)
    if not ok then
        return nil, "Pickup ditolak: " .. tostring(err)
    end
    for _ = 1, 25 do
        if not gui.Parent or localPlayer.Character ~= char then break end
        tool = findTrampoline(char, backpack)
        if tool then return tool end
        task.wait(0.1)
    end
    return nil, "Item trampoline asli belum masuk Backpack"
end

local function useGenuineTrampolineNearTarget()
    if trampolineBusy then
        setStatus("Proses trampoline masih berjalan")
        return
    end
    local target = selectedPlayer
    if not target or target.Parent ~= Players then
        setStatus("Pilih target terlebih dahulu")
        return
    end
    local targetChar = target.Character
    local tRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    if not tRoot or not targetHum or targetHum.Health <= 0 then
        setStatus("Target tidak siap")
        return
    end

    trampolineBusy = true
    task.spawn(function()
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        if not char or not hum or hum.Health <= 0 or not root or not backpack then
            setStatus("Karakter sendiri belum siap")
            trampolineBusy = false
            return
        end

        local tool, message = fetchTrampoline(char, backpack)
        if not tool then
            setStatus(message or "Trampoline asli tidak ditemukan")
            trampolineBusy = false
            return
        end

        local home = char:GetPivot()
        local activated = false
        local activatedConn = tool.Activated:Connect(function()
            activated = true
        end)
        local ok, err = pcall(function()
            hum.Sit = false
            hum:EquipTool(tool)
            task.wait(0.1)
            if tool.Parent ~= char then
                error("Trampoline gagal dipasang ke tangan")
            end
            -- Approach the target from a small distance, facing their feet.
            -- Assumes placement may occur in front of the character.
            -- This is an experiment, not a verified server placement API.
            local fresh = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not fresh then error("Target sudah berpindah/hilang") end
            local facing = fresh.CFrame.LookVector
            local nearPos = fresh.Position - facing * 3.0
            local placeFrom = Vector3.new(nearPos.X, fresh.Position.Y, nearPos.Z)
            char:PivotTo(CFrame.lookAt(placeFrom, fresh.Position))
            RunService.Heartbeat:Wait()
            if char.Parent and tool.Parent == char then
                tool:Activate() -- programmatic Tool activation, not a mouse click
                task.wait(0.18)
                tool:Deactivate()
            end
        end)
        -- Always try to restore the own avatar, even after an error.
        pcall(function()
            if char.Parent and localPlayer.Character == char then
                hum:UnequipTools()
                char:PivotTo(home)
                local r = char:FindFirstChild("HumanoidRootPart")
                if r then
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
        activatedConn:Disconnect()
        if not gui.Parent then
            trampolineBusy = false
            return
        end
        if not ok then
            setStatus("Trampoline gagal: " .. tostring(err):sub(1, 80))
        elseif activated then
            setStatus("Item asli diaktifkan dekat @" .. target.Name .. "; cek hasil server")
        else
            setStatus("Item dipegang, tetapi aktivasi tidak terdeteksi")
        end
        print("[XLORD V21] Tool asli:", tool.Name,
            "Aktivasi:", activated, "OK:", ok,
            "Target:", target.Name, "Error:", err)
        trampolineBusy = false
    end)
end

listen(trampolineButton.MouseButton1Click:Connect(useGenuineTrampolineNearTarget))

