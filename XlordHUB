local function selectProp(data)
    selectedProp = data.object
    selectedRemote = data.remote

    local ok, cf = pcall(function()
        return selectedProp:GetPivot()
    end)

    if ok then
        rotation = cf.Rotation
    else
        rotation = CFrame.new()
    end

    -- Supaya bagian bawah prop berada di kaki
    bottomOffset =
        calculateBottomOffset(selectedProp)

    propLabel.Text =
        "Prop: " .. selectedProp.Name

    notify(
        string.format(
            "Prop dipilih | Bottom offset: %.2f",
            bottomOffset
        )
    )
end

