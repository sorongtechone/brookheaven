--==========================================
-- DRAGGABLE GUI (PC & MOBILE)
--==========================================

local function makeDraggable(frame, handle)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local dragInput = nil

    bind(handle.InputBegan:Connect(function(input)
        if confirm.Visible then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            local ended
            ended = input.Changed:Connect(function()
                if input.UserInputState ==
                    Enum.UserInputState.End then

                    dragging = false
                    ended:Disconnect()
                end
            end)
        end
    end))

    bind(handle.InputChanged:Connect(function(input)
        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or input.UserInputType ==
            Enum.UserInputType.Touch then

            dragInput = input
        end
    end))

    bind(UIS.InputChanged:Connect(function(input)
        if not dragging
            or input ~= dragInput
            or not gui.Parent then
            return
        end

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end))
end

