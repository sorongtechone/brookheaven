    pullButton.Size = UDim2.fromOffset(halfW, 32)
    lookButton.Position = UDim2.fromOffset(10 + halfW + 6, row2Y)
    lookButton.Size = UDim2.fromOffset(halfW, 32)

    -- Baris 3: TRAMPOLINE full width, tipis
    local row3Y = row2Y + 38
