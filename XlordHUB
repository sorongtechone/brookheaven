    smaller.Size = UDim2.fromOffset(sizeBtn, sizeBtn)
    larger.Size = UDim2.fromOffset(sizeBtn, sizeBtn)
    minimize.Size = UDim2.fromOffset(sizeBtn, sizeBtn)
    close.Size = UDim2.fromOffset(sizeBtn, sizeBtn)

    propModeButton.Size = UDim2.fromOffset(sizeBtn, sizeBtn)
    xyzButton.Size = UDim2.fromOffset(sizeBtn, sizeBtn)
    antiSitButton.Size = UDim2.fromOffset(sizeBtn, sizeBtn)

    -- Posisi tombol dari kanan ke kiri
    close.Position = UDim2.fromOffset(width - 42, 6)
    minimize.Position = UDim2.fromOffset(width - 76, 6)
    larger.Position = UDim2.fromOffset(width - 110, 6)
    smaller.Position = UDim2.fromOffset(width - 144, 6)

    antiSitButton.Position = UDim2.fromOffset(width - 178, 6)
    xyzButton.Position = UDim2.fromOffset(width - 212, 6)
    propModeButton.Position = UDim2.fromOffset(width - 246, 6)

    antiSitButton.Visible = true

    -- Pencarian pemain
    search.Position = UDim2.fromOffset(10, 47)
    search.Size = UDim2.fromOffset(width - 20, 35)

    refresh.Position = UDim2.fromOffset(10, 88)
    refresh.Size = UDim2.fromOffset(width - 20, 31)

    -- Daftar pemain (footer lebih ringkas = daftar lebih tinggi)
    -- total footer = target(22) + TELEPORT/AUTO SOFA(34) + TARIK/LIHAT(32) + TRAMPOLINE(28) + status(28) + gaps
    local listHeight = math.max(60, height - 320)

    scroll.Position = UDim2.fromOffset(10, 125)
    scroll.Size = UDim2.fromOffset(width - 20, listHeight)

    -- Target & tombol aksi (compact)
    local targetY = 125 + listHeight + 6

    targetLabel.Position = UDim2.fromOffset(12, targetY)
    targetLabel.Size = UDim2.fromOffset(width - 24, 22)

    -- Baris 1: TELEPORT | AUTO SOFA (2 kolom)
    local row1Y = targetY + 26
