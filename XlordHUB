--====================================================
-- PLAYER LIST: update once after row changes.
--====================================================
local function refreshPlayers()
    if not gui.Parent then return end
    for _, item in ipairs(scroll:GetChildren()) do
        if item:IsA("TextButton") then item:Destroy() end
    end

    local needle = search.Text:lower()
    local all = Players:GetPlayers()
    table.sort(all, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    local index = 0
    for _, player in ipairs(all) do
        if player ~= localPlayer then
            local match = needle == ""
                or player.Name:lower():find(needle, 1, true)
                or player.DisplayName:lower():find(needle, 1, true)
            if match then
                index = index + 1
                local row = button(
                    scroll,
                    "Player_" .. player.UserId,
                    player.DisplayName .. " (@" .. player.Name .. ")",
                    selectedPlayer == player and COLORS.selected or COLORS.row
                )
                row.Size = UDim2.new(1, -15, 0, ROW_HEIGHT)
                row.LayoutOrder = index
                row.TextSize = 12
                row.TextXAlignment = Enum.TextXAlignment.Left
                row.TextTruncate = Enum.TextTruncate.AtEnd
                -- Destroying the row also disconnects its click handler.
                row.MouseButton1Click:Connect(function()
                    if flingRunning then stopFling(true) end
                    selectedPlayer = player
                    targetLabel.Text = "Target: @" .. player.Name
                    setStatus("Target dipilih")
                    refreshPlayers()
                end)
            end
        end
    end
    listCount = index
    updateCanvas(true)
    if index == 0 then setStatus("Tidak ada pemain yang cocok") end
end

