local function scanProps()
    -- Logika scan dikembalikan ke pola V3 yang sebelumnya terasa lebih cepat.
    -- Periksa folder prop yang dikenal sekali, tanpa fast-path lalu scan ulang.
    local found = {}
    local seen = {}

    local username = localPlayer.Name:lower()
    local ownedName = "prop" .. username

    local folders = {
        workspace:FindFirstChild("WorkspaceCom"),
        workspace:FindFirstChild("bh_Props"),
        workspace:FindFirstChild("Props")
    }

    local function inspect(obj)
        if not obj:IsA("Model") and not obj:IsA("BasePart") then
            return
        end

        local name = obj.Name:lower()
        local owned = name == ownedName or
            (name:find("prop", 1, true) and name:find(username, 1, true))

        if not owned then
            return
        end

        local remote = obj:FindFirstChild("SetCurrentCFrame", true)
        if not remote or not remote:IsA("RemoteFunction") then
            return
        end

        if not seen[obj] then
            seen[obj] = true
            table.insert(found, { object = obj, remote = remote })
        end
    end

    for _, folder in ipairs(folders) do
        if folder then
            inspect(folder)
            for _, obj in ipairs(folder:GetDescendants()) do
                inspect(obj)
            end
        end
    end

    return found
end
--------------------------------------------------
-- HITUNG POSISI BAWAH PROP
--------------------------------------------------

local function calculateBottomOffset(obj)
    local ok, result = pcall(function()
        local pivot = obj:GetPivot()

        local boundsCF
        local boundsSize

        if obj:IsA("Model") then
            boundsCF, boundsSize =
                obj:GetBoundingBox()
        else
            boundsCF = obj.CFrame
            boundsSize = obj.Size
        end

        local lowestY =
            boundsCF.Position.Y -
            boundsSize.Y / 2

        -- Jarak dari pivot sampai bawah prop
        return pivot.Position.Y - lowestY
    end)

    if ok and type(result) == "number" then
        return result
    end

    return 0
end

