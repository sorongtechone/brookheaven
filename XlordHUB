--==========================================
-- STOP FLING / CLEANUP FORCES
--==========================================

local function removeForces()
    if spinForce then
        spinForce:Destroy()
        spinForce = nil
    end

    if pushForce then
        pushForce:Destroy()
        pushForce = nil
    end
end

local function stopFling(restore)
    token = token + 1
    running = false

    removeForces()

    if restore
        and originalPos
        and activeChar
        and activeChar.Parent then

        pcall(function()
            activeChar:PivotTo(originalPos)

            local root =
                activeChar:FindFirstChild(
                    "HumanoidRootPart"
                )

            if root then
                root.AssemblyLinearVelocity =
                    Vector3.zero

                root.AssemblyAngularVelocity =
                    Vector3.zero
            end
        end)
    end

    originalPos = nil
    activeChar = nil

    flingButton.Text = "SOFA FLING : START"
    flingButton.BackgroundColor3 =
        Color3.fromRGB(185, 105, 38)
end

--==========================================
-- GET COUCH
--==========================================

local function getCouch()
    local char = LP.Character
    local backpack = LP:FindFirstChild("Backpack")

    if not char or not backpack then
        return nil, "Karakter belum tersedia"
    end

    local existing =
        char:FindFirstChild("Couch")
        or backpack:FindFirstChild("Couch")

    if existing and existing:IsA("Tool") then
        return existing
    end

    local re = RS:FindFirstChild("RE")
    local remote =
        re and re:FindFirstChild("1Too1l")

    if not remote
        or not remote:IsA("RemoteFunction") then

        return nil, "Remote Couch tidak ditemukan"
    end

    local ok = pcall(function()
        remote:InvokeServer(
            "PickingTools",
            "Couch"
        )
    end)

    if not ok then
        return nil, "Gagal mengambil Couch"
    end

    local couch =
        backpack:WaitForChild("Couch", 3)
        or char:FindFirstChild("Couch")

    if not couch or not couch:IsA("Tool") then
        return nil, "Couch tidak tersedia"
    end

    return couch
end

--==========================================
-- START SOFA FLING
--==========================================

local function startFling()
    if running then
        return
    end

    if not selected or selected.Parent ~= Players then
        setStatus("Pilih pemain terlebih dahulu!")
        return
    end

    local target = selected
    local char = LP.Character

    local root =
        char and char:FindFirstChild(
            "HumanoidRootPart"
        )

    local hum =
        char and char:FindFirstChildOfClass(
            "Humanoid"
        )

    if not root or not hum or hum.Health <= 0 then
        setStatus("Karakter sendiri belum siap")
        return
    end

    local targetRoot =
        target.Character and
        target.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not targetRoot then
        setStatus("Target belum siap")
        return
    end

    running = true
    token = token + 1

    local thisToken = token

    activeChar = char
    originalPos = char:GetPivot()

    flingButton.Text = "SOFA FLING : STOP"
    flingButton.BackgroundColor3 =
        Color3.fromRGB(200, 50, 65)

    setStatus("Mengambil sofa...")

    task.spawn(function()
        local couch, err = getCouch()

        if not running or token ~= thisToken then
            return
        end

        if not couch then
            stopFling(false)
            setStatus(err or "Gagal mengambil sofa")
            return
        end

        local equipped = pcall(function()
            hum:EquipTool(couch)
            task.wait(0.2)
            couch:Activate()
        end)

        if not running or token ~= thisToken then
            return
        end

        if not equipped then
            stopFling(false)
            setStatus("Gagal mengaktifkan sofa")
            return
        end

        -- Coba interaksi dengan sofa
        pcall(function()
            local vim = game:GetService(
                "VirtualInputManager"
            )

            vim:SendKeyEvent(
                true,
                Enum.KeyCode.F,
                false,
                game
            )

            vim:SendKeyEvent(
                false,
                Enum.KeyCode.F,
                false,
                game
            )
        end)

        if not running or token ~= thisToken then
            return
        end

        -- Dorongan fisika
        local push = Instance.new("BodyVelocity")
        push.Name = "XLORD_FlingPush"
        push.MaxForce = Vector3.new(
            200000,
            100000,
            200000
        )
        push.P = 12500
        push.Velocity = Vector3.zero
        push.Parent = root
        pushForce = push

        -- Rotasi fisika
        local spin = Instance.new(
            "BodyAngularVelocity"
        )
        spin.Name = "XLORD_FlingSpin"
        spin.MaxTorque = Vector3.new(
            1e8, 1e8, 1e8
        )
        spin.P = 50000
        spin.AngularVelocity =
            Vector3.new(0, 110, 0)
        spin.Parent = root
        spinForce = spin

        setStatus(
            "Fling aktif: @" .. target.Name
        )

        local beginTime = os.clock()
        local maxDuration = 8

        while running
            and token == thisToken
            and gui.Parent
            and char.Parent
            and target.Parent == Players do

            local tr =
                target.Character and
                target.Character:FindFirstChild(
                    "HumanoidRootPart"
                )

            local th =
                target.Character and
                target.Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            if not tr or not th or th.Health <= 0 then
                break
            end

            if os.clock() - beginTime >= maxDuration then
                break
            end

            local t = os.clock() - beginTime
            local angle = t * 28
            local radius = 1.3

            local offset = Vector3.new(
                math.cos(angle) * radius,
                math.sin(angle * 3) * 0.8,
                math.sin(angle) * radius
            )

            local destination =
                tr.Position + offset

            pcall(function()
                root.CFrame = CFrame.new(
                    destination,
                    tr.Position
                )

                local direction =
                    tr.Position - root.Position

                if direction.Magnitude > 0.01 then
                    push.Velocity =
                        direction.Unit * 135
                end

                root.AssemblyAngularVelocity =
                    Vector3.new(0, 110, 0)
            end)

            RunService.Heartbeat:Wait()
        end

        if token == thisToken then
            stopFling(true)
            setStatus("Sofa Fling selesai")
        end
    end)
end

--==========================================
-- TELEPORT TO SELECTED PLAYER
--==========================================

local function teleportToSelected()
    if not selected or selected.Parent ~= Players then
        setStatus("Pilih pemain terlebih dahulu!")
        return
    end

    if running then
        stopFling(true)
    end

    local char = LP.Character
    local tchar = selected.Character

    local root =
        char and char:FindFirstChild(
            "HumanoidRootPart"
        )

    local troot =
        tchar and tchar:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root or not troot then
        setStatus("Karakter belum tersedia")
        return
    end

    local hum =
        char:FindFirstChildOfClass("Humanoid")

    if hum then
        hum.Sit = false
    end

    char:PivotTo(
        troot.CFrame * CFrame.new(0, 0, 3)
    )

    setStatus(
        "Teleport ke @" .. selected.Name
    )
end

--==========================================
-- UPDATE PLAYER LIST
--==========================================

local function updatePlayers()
    if not gui.Parent then
        return
    end

    for _, child in ipairs(scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local keyword = search.Text:lower()
    local list = Players:GetPlayers()

    table.sort(list, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    local count = 0

    for _, player in ipairs(list) do
        if player ~= LP then
            local name = player.Name:lower()
            local display = player.DisplayName:lower()

            local matches =
                keyword == ""
                or name:find(keyword, 1, true)
                or display:find(keyword, 1, true)

            if matches then
                count = count + 1

                local color =
                    selected == player
                    and Color3.fromRGB(45, 125, 95)
                    or Color3.fromRGB(50, 54, 73)

                local button = makeButton(
                    scroll,
                    "Player_" .. player.Name,
                    player.DisplayName ..
                    " (@" .. player.Name .. ")",
                    UDim2.fromOffset(4, 0),
                    UDim2.new(1, -8, 0, 38),
                    color
                )

                button.LayoutOrder = count
                button.TextSize = 12

                button.MouseButton1Click:Connect(
                    function()

                        if running then
                            stopFling(true)
                        end

                        selected = player

                        selectedLabel.Text =
                            "Target: @" .. player.Name

                        setStatus("Target dipilih")

                        updatePlayers()
                    end
                )
            end
        end
    end

    if count == 0 then
        setStatus("Tidak ada pemain yang cocok")
    end
end

