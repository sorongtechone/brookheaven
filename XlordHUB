-- TELEPORT & AUTO SOFA (asli)
--====================================================
local selectedPlayer
local propTarget = nil

local trampolinePreview = nil
local trampolineBusy = false

local function isGenuineTrampoline(obj)
    if not obj or not obj:IsA("Tool") then return false end
    local n = obj.Name:lower():gsub("[%s_%-]", "")
    return n:find("trampoline", 1, true) ~= nil
        or n:find("trampolin", 1, true) ~= nil
end

local function findTrampoline(char, backpack)
    for _, container in ipairs({char, backpack}) do
        if container then
            for _, obj in ipairs(container:GetChildren()) do
                if isGenuineTrampoline(obj) then return obj end
            end
        end
    end
    return nil
end

local function fetchTrampoline(char, backpack)
    local tool = findTrampoline(char, backpack)
    if tool then return tool end
    local re = ReplicatedStorage:FindFirstChild("RE")
    local pickup = re and re:FindFirstChild("1Too1l")
    if not pickup or not pickup:IsA("RemoteFunction") then
        return nil, "Remote pengambilan item tidak tersedia"
    end
    setStatus("Mengambil trampoline merah asli...")
    local ok, err = pcall(function()
        pickup:InvokeServer("PickingTools", "Trampoline")
    end)
    if not ok then
        return nil, "Pickup ditolak: " .. tostring(err)
    end
    for _ = 1, 25 do
        if not gui.Parent or localPlayer.Character ~= char then break end
        tool = findTrampoline(char, backpack)
        if tool then return tool end
        task.wait(0.1)
    end
    return nil, "Item trampoline asli belum masuk Backpack"
end

local function useGenuineTrampolineNearTarget()
    if trampolineBusy then setStatus("Proses trampoline masih berjalan") return end
    local target = selectedPlayer
    if not target or target.Parent ~= Players then setStatus("Pilih target terlebih dahulu") return end
    local targetChar = target.Character
    local tRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
    if not tRoot or not targetHum or targetHum.Health <= 0 then setStatus("Target tidak siap") return end
    trampolineBusy = true
    task.spawn(function()
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        if not char or not hum or hum.Health <= 0 or not root or not backpack then
            setStatus("Karakter sendiri belum siap"); trampolineBusy = false; return
        end
        local tool, message = fetchTrampoline(char, backpack)
        if not tool then
            setStatus(message or "Trampoline asli tidak ditemukan"); trampolineBusy = false; return
        end
        local home = char:GetPivot()
        local activated = false
        local activatedConn = tool.Activated:Connect(function() activated = true end)
        local ok, err = pcall(function()
            hum.Sit = false
            hum:EquipTool(tool)
            task.wait(0.1)
            if tool.Parent ~= char then error("Trampoline gagal dipasang ke tangan") end
            local fresh = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
            if not fresh then error("Target sudah berpindah/hilang") end
            local facing = fresh.CFrame.LookVector
            local nearPos = fresh.Position - facing * 3.0
            local placeFrom = Vector3.new(nearPos.X, fresh.Position.Y, nearPos.Z)
            char:PivotTo(CFrame.lookAt(placeFrom, fresh.Position))
            RunService.Heartbeat:Wait()
            if char.Parent and tool.Parent == char then
                tool:Activate(); task.wait(0.18); tool:Deactivate()
            end
        end)
        pcall(function()
            if char.Parent and localPlayer.Character == char then
                hum:UnequipTools(); char:PivotTo(home)
                local r = char:FindFirstChild("HumanoidRootPart")
                if r then
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
        activatedConn:Disconnect()
        if not gui.Parent then trampolineBusy = false return end
        if not ok then setStatus("Trampoline gagal: " .. tostring(err):sub(1, 80))
        elseif activated then setStatus("Item asli diaktifkan dekat @" .. target.Name .. "; cek hasil server")
        else setStatus("Item dipegang, tetapi aktivasi tidak terdeteksi") end
        trampolineBusy = false
    end)
end

listen(trampolineButton.MouseButton1Click:Connect(useGenuineTrampolineNearTarget))

--====================================================
-- TARIK PLAYER
--====================================================
local pullRunning = false
local pullToken = 0
local pullConnection = nil
local pullTarget = nil

local function stopPull(message)
    pullToken = pullToken + 1
    pullRunning = false
    if pullConnection then pcall(function() pullConnection:Disconnect() end); pullConnection = nil end
    if pullTarget and pullTarget.Character then
        local tRoot = pullTarget.Character:FindFirstChild("HumanoidRootPart")
        if tRoot then
            for _, child in ipairs(tRoot:GetChildren()) do
                if child.Name == "XLORD_PullPos" or child.Name == "XLORD_PullVel" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end
    pullTarget = nil
    pullButton.Text = "TARIK"
    pullButton.BackgroundColor3 = COLORS.purple
    if message then setStatus(message) end
end

local function startPull()
    if pullRunning then stopPull("Tarik player dihentikan") return end
    local target = selectedPlayer
    if not target or target.Parent ~= Players then setStatus("Pilih target terlebih dahulu") return end
    local myChar = localPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 then setStatus("Karakter kamu belum siap") return end
    local tChar = target.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then setStatus("Target tidak siap") return end

    pullRunning = true
    pullToken = pullToken + 1
    local myToken = pullToken
    pullTarget = target
    pullButton.Text = "STOP TARIK"
    pullButton.BackgroundColor3 = COLORS.red
    setStatus("Menarik @" .. target.Name .. "...")

    local bpos = Instance.new("BodyPosition")
    bpos.Name = "XLORD_PullPos"
    bpos.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bpos.P = 25000; bpos.D = 900
    bpos.Position = tRoot.Position
    bpos.Parent = tRoot

    local bvel = Instance.new("BodyVelocity")
    bvel.Name = "XLORD_PullVel"
    bvel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bvel.P = 12500
    bvel.Velocity = Vector3.zero
    bvel.Parent = tRoot

    local started = os.clock()
    local MAX_PULL = 1.5
    local DIST_STOP = 3.0

    pullConnection = RunService.Heartbeat:Connect(function()
        if pullToken ~= myToken or not pullRunning then return end
        if gui.Parent == nil then stopPull(nil) return end
        if localPlayer.Character ~= myChar then stopPull("Karakter berubah") return end
        if not tRoot.Parent or target.Parent ~= Players then stopPull("Target hilang") return end
        if tHum.Health <= 0 then stopPull("Target mati") return end
        local myRootNow = myChar:FindFirstChild("HumanoidRootPart")
        if not myRootNow then stopPull("Karakter kamu hilang") return end
        if tHum.Sit then stopPull("Target duduk: tarik selesai") return end
        local dist = (myRootNow.Position - tRoot.Position).Magnitude
        if dist <= DIST_STOP or os.clock() - started >= MAX_PULL then
            stopPull("Tarik selesai (" .. string.format("%.1f", dist) .. " studs)")
            return
        end
        local goal = myRootNow.Position + myRootNow.CFrame.LookVector * 2.5
        bpos.Position = goal
        bvel.Velocity = (goal - tRoot.Position).Unit * 45
    end)
end
