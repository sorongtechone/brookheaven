local function scanProps()
    local ownedFound, fallbackFound = {}, {}
    local seen = {}
    local username = localPlayer.Name:lower()
    local ownedName = "prop" .. username

    local folders = {
        workspace:FindFirstChild("WorkspaceCom"),
        workspace:FindFirstChild("bh_Props"),
        workspace:FindFirstChild("Props")
    }

    local function inspect(obj)
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
        if seen[obj] then return end
        local name = obj.Name:lower()
        local remote = obj:FindFirstChild("SetCurrentCFrame", true)
        if not remote or not remote:IsA("RemoteFunction") then return end
        seen[obj] = true
        local entry = { object = obj, remote = remote }
        local ownerMatch = name == ownedName
            or (name:find("prop", 1, true) and name:find(username, 1, true))
        if ownerMatch then
            table.insert(ownedFound, entry)
        elseif name:find("prop", 1, true) then
            table.insert(fallbackFound, entry)
        end
    end

    for _, folder in ipairs(folders) do
        if folder then
            for _, obj in ipairs(folder:GetDescendants()) do
                inspect(obj)
            end
            inspect(folder)
        end
    end

    if #ownedFound > 0 then return ownedFound, false end
    return fallbackFound, #fallbackFound > 0
end

local function calculateBottomOffset(obj)
    local ok, result = pcall(function()
        local pivot = obj:GetPivot()
        local boundsCF, boundsSize
        if obj:IsA("Model") then
            boundsCF, boundsSize = obj:GetBoundingBox()
        else
            boundsCF = obj.CFrame
            boundsSize = obj.Size
        end
        local lowestY = boundsCF.Position.Y - boundsSize.Y / 2
        return pivot.Position.Y - lowestY
    end)
    if ok and type(result) == "number" then return result end
    return 0
end

local function selectProp(data)
    selectedProp = data.object
    selectedRemote = data.remote
    local ok, cf = pcall(function() return selectedProp:GetPivot() end)
    if ok then rotation = cf.Rotation else rotation = CFrame.new() end
    bottomOffset = calculateBottomOffset(selectedProp)
    propLabel.Text = "Prop: " .. selectedProp.Name
    notify(string.format("Prop dipilih | Bottom offset: %.2f", bottomOffset))
end

