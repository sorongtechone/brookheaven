    if fallbackScan then notify("Prop pemilik tidak terdeteksi dari nama; pilih kandidat prop yang sesuai") end
    if #found == 1 then selectProp(found[1]) return end
    local items = {}
    for i, data in ipairs(found) do
        table.insert(items, { label = "Prop " .. i .. " | " .. data.object.Name, value = data })
    end
    openPicker(items, selectProp)
end)
local function getTargetRoot()
    propTarget = selectedPlayer
    if not propTarget or propTarget.Parent ~= Players then return nil end
    local character = propTarget.Character
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart")
end
local function getFootHeight(root)
    local character = root.Parent
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return root.Position.Y - 3 end
    local distance = humanoid.HipHeight + root.Size.Y / 2
    return root.Position.Y - distance
end
local function calculatePosition(root)
    local heightOffset = math.clamp(tonumber(heightBox.Text) or 0, -10, 20)
    local velocity = root.AssemblyLinearVelocity
    local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
    if horizontalVelocity.Magnitude > MAX_VELOCITY then
        horizontalVelocity = horizontalVelocity.Unit * MAX_VELOCITY
    end
    local predictionTime = math.clamp(BASE_PREDICTION + lastRTT * 0.5, BASE_PREDICTION, MAX_PREDICTION)
    local predicted = horizontalVelocity * predictionTime
    local footY = getFootHeight(root)
    local finalY = footY + bottomOffset + heightOffset
    return Vector3.new(root.Position.X + predicted.X, finalY, root.Position.Z + predicted.Z)
end
local function followLoop(myToken)
    local lastPosition = nil
    local lastStatus = 0
    local consecutiveErrors = 0
    while running and propAlive and token == myToken do
        local root = getTargetRoot()
        if not root then notify("Menunggu target...") task.wait(0.2) continue end
        if not selectedProp or not selectedProp.Parent then notify("Prop hilang") break end
        local remote = selectedRemote
        if not remote or not remote.Parent or not remote:IsA("RemoteFunction") then
            notify("Remote prop hilang") break
        end
        local position = calculatePosition(root)
        local moved = not lastPosition or (position - lastPosition).Magnitude >= MIN_MOVEMENT
        if moved then
            local goal = CFrame.new(position) * rotation
            local startTime = os.clock()
            local ok, result = pcall(function() return remote:InvokeServer(goal) end)
            lastRTT = os.clock() - startTime
            if not running or token ~= myToken then break end
            if ok and result ~= false then
                successCount += 1
                consecutiveErrors = 0
                lastPosition = position
                if os.clock() - lastStatus >= 0.8 then
                    notify("FOLLOW KAKI: @" .. (propTarget and propTarget.Name or "target"))
                    updateStats(); lastStatus = os.clock()
                end
            else
                errorCount += 1
                consecutiveErrors += 1
                notify("Remote error: " .. tostring(result))
                updateStats()
                if consecutiveErrors >= MAX_ERRORS then notify("STOP: Terlalu banyak error") break end
                task.wait(ERROR_DELAY)
            end
        end
        task.wait(SEND_INTERVAL)
    end
    if token == myToken then running = false; updateToggle(); updateStats() end
end
local function stopFollow()
    running = false; token += 1; updateToggle(); updateStats(); notify("Follow dihentikan")
end
local function startFollow()
    if running then return end
    if not propTarget then notify("Pilih pemain dahulu") return end
    if not selectedProp then notify("Scan prop dahulu") return end
    if not selectedProp.Parent then notify("Prop sudah tidak tersedia") return end
    if not selectedRemote or not selectedRemote.Parent then notify("Remote prop tidak tersedia") return end
    if not getTargetRoot() then notify("Karakter target belum tersedia") return end
    running = true; token += 1
    lastRTT = 0; successCount = 0; errorCount = 0
    updateToggle(); updateStats()
    notify("FAST FOLLOW FEET: @" .. (propTarget and propTarget.Name or "target"))
    local myToken = token
    task.spawn(function() followLoop(myToken) end)
end
propBind(toggle.MouseButton1Click, function()
    if running then stopFollow() else startFollow() end
end)
