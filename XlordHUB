--==========================================
-- RESPONSIVE GUI SCALE
--==========================================

local scale = Instance.new("UIScale")
scale.Name = "XLORD_UIScale"
scale.Parent = main

local function getMaxScale()
    local camera = workspace.CurrentCamera

    if not camera then
        return 1.0
    end

    local view = camera.ViewportSize

    local widthLimit = (view.X - 24) / 320
    local heightLimit = (view.Y - 24) / 470

    return math.max(
        MIN_SCALE,
        math.min(
            MAX_SCALE,
            widthLimit,
            heightLimit
        )
    )
end

local function setScale(value)
    scale.Scale = math.clamp(
        value,
        MIN_SCALE,
        getMaxScale()
    )
end

