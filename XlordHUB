local flingRunning = false
local flingToken = 0
local savedPivot = nil
local flingCharacter = nil
local pushForce = nil
local spinForce = nil
local activeCouchTool = nil

-- Lepaskan sofa milik sendiri. Tidak mengubah Tool milik target.
local function releaseOwnCouch()
    if activeCouchTool and activeCouchTool.Parent then
        pcall(function()
            if activeCouchTool.Parent == localPlayer.Character then
                activeCouchTool:Deactivate()
            end
        end)
        local character = localPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            pcall(function() humanoid:UnequipTools() end)
        end
    end
    activeCouchTool = nil
end

local function stopFling(restore)
    -- Mematikan token membuat task yang masih menunggu langsung tidak valid.
    flingToken = flingToken + 1
    flingRunning = false
    if pushForce then pushForce:Destroy(); pushForce = nil end
    if spinForce then spinForce:Destroy(); spinForce = nil end

    -- Penting: lepaskan sofa SEBELUM memulihkan posisi pemain.
    releaseOwnCouch()

    if restore and savedPivot and flingCharacter and flingCharacter.Parent
       and localPlayer.Character == flingCharacter then
        pcall(function()
            local humanoid = flingCharacter:FindFirstChildOfClass("Humanoid")
            if humanoid then humanoid.Sit = false end
            flingCharacter:PivotTo(savedPivot)
            local root = flingCharacter:FindFirstChild("HumanoidRootPart")
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end

    savedPivot = nil
    flingCharacter = nil
    fling.Text = "AUTO SOFA : START"
    fling.BackgroundColor3 = COLORS.orange
end

local function getCouch()
    local character = localPlayer.Character
    local backpack = localPlayer:FindFirstChildOfClass("Backpack")
    if not character or not backpack then
        return nil, "Karakter atau Backpack tidak ada"
    end
    local found = character:FindFirstChild("Couch") or backpack:FindFirstChild("Couch")
    if found and found:IsA("Tool") then return found end

    local reFolder = ReplicatedStorage:FindFirstChild("RE")
    local remote = reFolder and reFolder:FindFirstChild("1Too1l")
    if not remote or not remote:IsA("RemoteFunction") then
        return nil, "Remote Couch tidak ditemukan"
    end

    local ok = pcall(function()
        remote:InvokeServer("PickingTools", "Couch")
    end)
    if not ok then return nil, "Permintaan Couch gagal" end
    local tool = backpack:WaitForChild("Couch", 3) or character:FindFirstChild("Couch")
    if not tool or not tool:IsA("Tool") then
        return nil, "Couch tidak tersedia"
    end
    return tool
end

local function teleportToSelected()
    if not selectedPlayer or selectedPlayer.Parent ~= Players then
        setStatus("Pilih target terlebih dahulu")
        return
    end
    if flingRunning then stopFling(true) end
    local character = localPlayer.Character
    local theirs = selectedPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local theirRoot = theirs and theirs:FindFirstChild("HumanoidRootPart")
    if not root or not theirRoot then
        setStatus("Karakter target belum siap")
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.Sit = false end
    character:PivotTo(theirRoot.CFrame * CFrame.new(0, 0, 3))
    setStatus("Teleport ke @" .. selectedPlayer.Name)
end

--====================================================
-- ONE-CLICK AUTO SOFA: V4 ORBIT -> SEAT TP -> THROW
-- -> UNEQUIP COUCH -> RETURN TO ORIGINAL POSITION.
-- Jika target sudah duduk, langsung TP tanpa orbit.
-- Jika belum duduk, orbit V4 dipakai untuk mencoba mendekat.
-- Proses dibatalkan dengan STOP atau jika target tak duduk (8 detik).
--====================================================
local MAX_AUTO_WAIT = 8.0
local AUTO_DESTINATION = Vector3.new(52.65, -573, 279.75)
local AUTO_SIDE_SPEED = 155
local AUTO_DOWN_SPEED = 140
local AUTO_SPIN_SPEED = 105

local function getTargetSeat(target)
    local character = target and target.Character
    local hum = character and character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return nil, "Target belum siap"
    end

    local seat = hum.SeatPart
    if not seat or not (seat:IsA("Seat") or seat:IsA("VehicleSeat")) then
        return nil, "Target belum duduk di sofa"
    end
    if not seat:IsDescendantOf(workspace) or seat.Occupant ~= hum then
        return nil, "Seat target tidak valid"
    end
    if seat.Anchored then
        return nil, "Seat target Anchored"
    end
    return seat
end

-- Fungsi ini memindahkan Seat yang sedang diduduki target, bukan
-- mengubah posisi pemain lain langsung melalui HumanoidRootPart.
local function autoMoveSeatAndThrow(target, seat)
    local targetChar = target.Character
    local beforeRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    local beforeY = beforeRoot and beforeRoot.Position.Y or 0
    local pose = seat:GetPivot()
    local origin = pose.Position
    local rotation = pose - origin
    -- Pindahkan sofa sambil mengarahkan posisi HumanoidRootPart
    -- target ke koordinat spesifik yang diminta. Offset duduk
    -- dipertahankan agar posisi target tidak bergeser dari titik tuju.
    local seatedRootPosition = beforeRoot and beforeRoot.Position or origin
    local seatDestinationPosition = origin + (AUTO_DESTINATION - seatedRootPosition)
    local destination = CFrame.new(seatDestinationPosition) * rotation

    -- Arah dorongan diambil dari orientasi sofa, bukan asumsi pusat map.
    local forward = pose.LookVector
    local horizontal = Vector3.new(forward.X, 0, forward.Z)
    if horizontal.Magnitude < 0.01 then
        horizontal = Vector3.new(1, 0, 0)
    else
        horizontal = horizontal.Unit
    end
    local velocity = horizontal * AUTO_SIDE_SPEED + Vector3.new(0, -AUTO_DOWN_SPEED, 0)

    local okMove, errMove = pcall(function()
        seat:PivotTo(destination)
    end)
    if not okMove then
        return false, "Teleport sofa gagal: " .. tostring(errMove):sub(1, 48)
    end

    -- Coba beri impuls tepat setelah teleport; tidak mengklaim
    -- target benar-benar terdorong di server Roblox.
    local okThrow, errThrow = pcall(function()
        seat.AssemblyLinearVelocity = velocity
        seat.AssemblyAngularVelocity = Vector3.new(0, AUTO_SPIN_SPEED, 0)
        seat:ApplyImpulse(velocity * seat.AssemblyMass)
    end)
    if not okThrow then
        warn("[XLORD V14] Impulse gagal:", tostring(errThrow))
    end
    return true, string.format("Target TP ke X=%.2f Y=%.2f Z=%.2f (awal Y=%.0f); throw=%s",
        AUTO_DESTINATION.X, AUTO_DESTINATION.Y, AUTO_DESTINATION.Z,
        beforeY, okThrow and "dicoba" or "gagal")
end

--====================================================
-- OWN HP RECOVERY TEST (CLIENT ONLY)
-- Server Roblox tetap yang menentukan HP sebenarnya.
-- Ini HANYA tes nilai lokal; perubahan bisa ditolak/ditimpa
-- server dan tidak bisa membangkitkan karakter yang sudah mati.
--====================================================
local function tryRestoreOwnHP(character)
    if not character or localPlayer.Character ~= character then return end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        setStatus("Karakter mati: HP tidak bisa dipulihkan dari client. Tunggu respawn.")
        return
    end
    local priorHP = hum.Health
    local maxHP = hum.MaxHealth
    if priorHP >= maxHP then
        setStatus("AUTO selesai | HP sudah penuh: " .. math.floor(priorHP))
        return
    end
    local ok = pcall(function()
        hum.Health = maxHP
    end)
    if not ok then
        setStatus("AUTO selesai | Client tidak bisa mengubah HP")
        return
    end
    -- Baca ulang: perubahan di sini hanya nilai lokal, bukan bukti server setuju.
    setStatus(string.format("AUTO selesai | Tes HP lokal %.0f -> %.0f (cek server)", priorHP, hum.Health))
    task.delay(1, function()
        if not gui.Parent or localPlayer.Character ~= character then return end
        local latest = character:FindFirstChildOfClass("Humanoid")
        if not latest then return end
        local suffix = latest.Health < maxHP - 0.5
            and "HP berubah lagi: server/game membatasi heal"
            or "HP terlihat penuh di client, belum tentu server"
        setStatus(string.format("%s | HP %.0f/%.0f", suffix, latest.Health, latest.MaxHealth))
    end)
end

-- Jika auto sofa membuat karakter mati, biarkan server me-respawn
-- lalu coba pulihkan POSISI ke tempat awal. Respawn game normal
-- biasanya menghasilkan HP penuh; bukan heal instan oleh Delta.
local lastSafeRespawnPivot = nil
local lastAutoTimestamp = -1000
local pendingRespawnPivot = nil

local function watchCharacterDeath(character)
    task.spawn(function()
        local hum = character:FindFirstChildOfClass("Humanoid")
            or character:WaitForChild("Humanoid", 10)
        if not hum or not gui.Parent then return end
        listen(hum.Died:Connect(function()
            if lastSafeRespawnPivot
                and os.clock() - lastAutoTimestamp < 14 then
                pendingRespawnPivot = lastSafeRespawnPivot
                setStatus("HP = 0. Tunggu respawn normal, coba kembali ke posisi awal...")
            end
        end))
    end)
end

local function startFling()
    if flingRunning then return end
    local target = selectedPlayer
    if not target or target.Parent ~= Players then
        setStatus("Pilih pemain target terlebih dahulu")
        return
    end

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not root or not humanoid or humanoid.Health <= 0 then
        setStatus("Karakter kamu belum siap")
        return
    end

    -- Simpan posisi sebelum pindah atau melakukan tindakan apapun.
    flingRunning = true
    flingToken = flingToken + 1
    local myToken = flingToken
    flingCharacter = character
    savedPivot = character:GetPivot()
    lastSafeRespawnPivot = savedPivot
    lastAutoTimestamp = os.clock()
    fling.Text = "AUTO SOFA : STOP"
    fling.BackgroundColor3 = COLORS.red

    task.spawn(function()
        -- Satu rangkaian otomatis: tidak perlu menekan Couch TP lagi.
        local function isCurrent()
            return gui.Parent and flingRunning and myToken == flingToken
                and localPlayer.Character == character
                and target.Parent == Players
        end
        local seat, seatError = getTargetSeat(target)

        -- Jika target belum duduk, ambil sofa dan coba pola orbit V4.
        if not seat then
            setStatus("Menyiapkan sofa dan mendekati target...")
            local couch, err = getCouch()
            if not isCurrent() then return end
            if not couch then
                stopFling(true)
                setStatus(err or "Gagal mengambil sofa")
                return
            end
            activeCouchTool = couch

            local okEquip = pcall(function()
                humanoid:EquipTool(couch)
                task.wait(0.15)
                couch:Activate()
            end)
            if not isCurrent() then return end
            if not okEquip then
                stopFling(true)
                setStatus("Gagal mengaktifkan sofa")
                return
            end

            -- Pertahankan pendekatan orbit V4 agar perilaku lama tidak hilang.
            local push = Instance.new("BodyVelocity")
            push.Name = "XLORD_AutoPush"
            push.MaxForce = Vector3.new(200000, 100000, 200000)
            push.P = 12500
            push.Velocity = Vector3.zero
            push.Parent = root
            pushForce = push

            local spin = Instance.new("BodyAngularVelocity")
            spin.Name = "XLORD_AutoSpin"
            spin.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
            spin.P = 50000
            spin.AngularVelocity = Vector3.new(0, 110, 0)
            spin.Parent = root
            spinForce = spin

            local started = os.clock()
            setStatus("Mencoba menangkap target di sofa (maks. 8 detik)...")
            while isCurrent() and os.clock() - started < MAX_AUTO_WAIT do
                seat, seatError = getTargetSeat(target)
                if seat then break end
                -- Seat duduk tetapi anchored? tidak mungkin TP secara lokal.
                if seatError == "Seat target Anchored" then break end

                local targetChar = target.Character
                local theirRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                local theirHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                if not theirRoot or not theirHum or theirHum.Health <= 0
                    or humanoid.Health <= 0 then
                    break
                end
                local t = os.clock() - started
                local angle = t * 28
                local offset = Vector3.new(
                    math.cos(angle) * 1.3,
                    math.sin(angle * 3) * 0.8,
                    math.sin(angle) * 1.3
                )
                pcall(function()
                    root.CFrame = CFrame.new(theirRoot.Position + offset, theirRoot.Position)
                    local direction = theirRoot.Position - root.Position
                    if direction.Magnitude > 0.01 then
                        push.Velocity = direction.Unit * 135
                    end
                    root.AssemblyAngularVelocity = Vector3.new(0, 110, 0)
                end)
                RunService.Heartbeat:Wait()
            end
        end

        if not isCurrent() then return end
        if not seat then
            stopFling(true)
            setStatus("Auto dibatalkan: " .. (seatError or "target tidak duduk dalam 8 detik"))
            return
        end

        -- Matikan gaya orbit milik kita sebelum teleport sofa.
        if pushForce then pushForce:Destroy(); pushForce = nil end
        if spinForce then spinForce:Destroy(); spinForce = nil end
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero

        setStatus("Target duduk! TP ke X=52.65 Y=-573 Z=279.75...")
        local okMove, result = autoMoveSeatAndThrow(target, seat)
        if not isCurrent() then return end
        if not okMove then
            stopFling(true)
            setStatus(result)
            return
        end

        -- Rollback ke V11: beri waktu pendek untuk fisika target.
        task.wait(0.18)
        if not isCurrent() then return end
        setStatus("Teleport selesai. Melepas sofa...")
        releaseOwnCouch()
        task.wait(0.08)
        if not isCurrent() then return end

        -- Auto return seperti V11, lalu uji pemulihan HP diri sendiri.
        stopFling(true)
        setStatus("AUTO selesai: " .. result .. " | Sofa lepas, kamu kembali")
        lastAutoTimestamp = os.clock()
        tryRestoreOwnHP(character)
        print("[XLORD V14] AUTO:", result)
        print("[XLORD V14] HP dari client tidak menjamin server menerima heal")
    end)
end

