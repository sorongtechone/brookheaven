-- Fungsi helper remote & client sound
local function fireServerAudio(workspaceOrNil, id)
    local re = ReplicatedStorage:FindFirstChild("RE")
    local remote = re and re:FindFirstChild("1Gu1nSound1s")
    if remote then
        pcall(function()
            remote:FireServer(workspaceOrNil or workspace, id, 1)
        end)
        return true
    end
    return false
end

local function playClientSound(id)
    local char = localPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. tostring(id)
    sound.Volume = 1
    sound.Parent = root
    sound:Play()
    task.delay(10, function()
        pcall(function()
            if sound.Parent then sound:Destroy() end
        end)
    end)
end

local function playAudioOnce(id, alsoClient)
    if not id then musicNotify("ID audio belum diisi"); return end
    local ok = fireServerAudio(workspace, id)
    if alsoClient ~= false then playClientSound(id) end
    musicNotify((ok and "Server audio OK" or "Remote tidak ada, client-only") .. " | ID " .. tostring(id))
end

local function startMusicLoop()
    musicLoopEnabled = true
    loopThreadToken = loopThreadToken + 1
    local myToken = loopThreadToken
    musicLoopToggle.Text = "ULANGI: ON"
    musicLoopToggle.BackgroundColor3 = COLORS.green
    task.spawn(function()
        while musicLoopEnabled and loopThreadToken == myToken and gui.Parent do
            if selectedAudioID then
                playAudioOnce(selectedAudioID, true)
            end
            task.wait(0.8)
        end
        if loopThreadToken == myToken then
            musicLoopEnabled = false
            musicLoopToggle.Text = "ULANGI: OFF"
            musicLoopToggle.BackgroundColor3 = COLORS.gray
        end
    end)
end

