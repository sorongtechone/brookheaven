local flingRunning = false
local flingToken = 0
local savedPivot
local flingCharacter
local pushForce
local spinForce

local function stopFling(restore)
    flingToken = flingToken + 1
    flingRunning = false
    if pushForce then pushForce:Destroy(); pushForce = nil end
    if spinForce then spinForce:Destroy(); spinForce = nil end

    if restore and savedPivot and flingCharacter and flingCharacter.Parent
       and localPlayer.Character == flingCharacter then
        pcall(function()
            local hum = flingCharacter:FindFirstChildOfClass("Humanoid")
            if hum then hum.Sit = false end
            flingCharacter:PivotTo(savedPivot)
            local root = flingCharacter:FindFirstChild("HumanoidRootPart")
            if root then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end)
    end

    savedPivot = nil
    flingCharacter = nil
    fling.Text = "SIDE FLING : START"
    fling.BackgroundColor3 = COLORS.orange
end

local function getCouch()
    local character = localPlayer.Character
    local backpack = localPlayer:FindFirstChildOfClass("Backpack")
    if not character or not backpack then
        return nil, "Karakter atau Backpack tidak ada"
    end
    local found = character:FindFirstChild("Couch") or backpack:FindFirstChild("Couch")
    if found and found:IsA("Tool") then return found end

    local reFolder = ReplicatedStorage:FindFirstChild("RE")
    local remote = reFolder and reFolder:FindFirstChild("1Too1l")
    if not remote or not remote:IsA("RemoteFunction") then
        return nil, "Remote Couch tidak ditemukan"
    end

    local ok = pcall(function()
        remote:InvokeServer("PickingTools", "Couch")
    end)
    if not ok then return nil, "Permintaan Couch gagal" end
    local tool = backpack:WaitForChild("Couch", 3) or character:FindFirstChild("Couch")
    if not tool or not tool:IsA("Tool") then
        return nil, "Couch tidak tersedia"
    end
    return tool
end

local function teleportToSelected()
    if not selectedPlayer or selectedPlayer.Parent ~= Players then
        setStatus("Pilih target terlebih dahulu")
        return
    end
    if flingRunning then stopFling(true) end
    local character = localPlayer.Character
    local theirs = selectedPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local theirRoot = theirs and theirs:FindFirstChild("HumanoidRootPart")
    if not root or not theirRoot then
        setStatus("Karakter target belum siap")
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.Sit = false end
    character:PivotTo(theirRoot.CFrame * CFrame.new(0, 0, 3))
    setStatus("Teleport ke @" .. selectedPlayer.Name)
end

-- Titik tengah map hanya pendekatan (koordinat Brookhaven bisa berubah).
-- Menggunakan vektor menjauh dari titik ini untuk arah dorongan horizontal.
local MAP_CENTER = Vector3.new(0, 0, 0)
local SIDE_SPEED = 190
local MAX_FLING_SECONDS = 3.0
local PULSE_SECONDS = 0.28

local function outwardDirection(targetRoot)
    local pos = targetRoot.Position
    local v = Vector3.new(pos.X - MAP_CENTER.X, 0, pos.Z - MAP_CENTER.Z)
    if v.Magnitude < 8 then
        -- Di dekat pusat, gunakan arah hadap target.
        local look = targetRoot.CFrame.LookVector
        v = Vector3.new(look.X, 0, look.Z)
    end
    if v.Magnitude < 0.01 then v = Vector3.new(1, 0, 0) end
    return v.Unit
end

local function startFling()
    if flingRunning then return end
    local target = selectedPlayer
    if not target or target.Parent ~= Players then
        setStatus("Pilih target terlebih dahulu")
        return
    end

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local theirChar = target.Character
    local theirRoot = theirChar and theirChar:FindFirstChild("HumanoidRootPart")
    local theirHum = theirChar and theirChar:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0
        or not theirRoot or not theirHum or theirHum.Health <= 0 then
        setStatus("Karakter sendiri atau target belum siap")
        return
    end

    -- Posisi asli disimpan sebelum mengaktifkan sofa/gerakan apa pun.
    flingRunning = true
    flingToken = flingToken + 1
    local myToken = flingToken
    flingCharacter = character
    savedPivot = character:GetPivot()
    fling.Text = "SIDE FLING : STOP"
    fling.BackgroundColor3 = COLORS.red
    setStatus("Menyiapkan sofa dan posisi pulang...")

    task.spawn(function()
        local couch, err = getCouch()
        if not flingRunning or myToken ~= flingToken then return end
        if not couch then
            stopFling(true)
            setStatus(err or "Sofa tidak tersedia")
            return
        end

        local equipped = pcall(function()
            humanoid:EquipTool(couch)
            task.wait(0.2)
            couch:Activate()
        end)
        if not flingRunning or myToken ~= flingToken then return end
        if not equipped then
            stopFling(true)
            setStatus("Sofa gagal diaktifkan")
            return
        end

        -- Interaksi tambahan yang mungkin tidak ada pada beberapa versi.
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.F, false, game)
            vim:SendKeyEvent(false, Enum.KeyCode.F, false, game)
        end)
        if not flingRunning or myToken ~= flingToken then return end

        -- Force hanya diterapkan ke karakter milik sendiri.
        -- Target hanya terdorong bila collision direplikasi server.
        local push = Instance.new("BodyVelocity")
        push.Name = "XLORD_SidePush"
        push.MaxForce = Vector3.new(900000, 450000, 900000)
        push.P = 60000
        push.Velocity = Vector3.zero
        push.Parent = root
        pushForce = push

        local spin = Instance.new("BodyAngularVelocity")
        spin.Name = "XLORD_SideSpin"
        spin.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        spin.P = 45000
        spin.AngularVelocity = Vector3.new(0, 85, 0)
        spin.Parent = root
        spinForce = spin

        setStatus("Mencoba Side Fling ke luar map: @" .. target.Name)

        local started = os.clock()
        local lastPulse = -1

        while flingRunning and myToken == flingToken and gui.Parent
            and target.Parent == Players and character.Parent
            and localPlayer.Character == character
            and os.clock() - started < MAX_FLING_SECONDS do

            local newChar = target.Character
            local newRoot = newChar and newChar:FindFirstChild("HumanoidRootPart")
            local newHum = newChar and newChar:FindFirstChildOfClass("Humanoid")
            if not newRoot or not newHum or newHum.Health <= 0
                or humanoid.Health <= 0 then break end

            local direction = outwardDirection(newRoot)
            local pulse = math.floor((os.clock() - started) / PULSE_SECONDS)

            if pulse ~= lastPulse then
                lastPulse = pulse
                -- Dekat dari sisi dalam map, lalu bergerak ke sisi luar.
                -- Tidak memaksa target ke bawah tanah.
                local approach = newRoot.Position - direction * 3.4
                    + Vector3.new(0, 0.6, 0)
                local sideVelocity = direction * SIDE_SPEED
                    + Vector3.new(0, 12, 0)

                pcall(function()
                    root.CFrame = CFrame.new(approach, approach + direction)
                    root.AssemblyLinearVelocity = sideVelocity
                    root.AssemblyAngularVelocity = Vector3.new(0, 85, 0)
                    push.Velocity = sideVelocity
                end)
            end
            RunService.Heartbeat:Wait()
        end

        if myToken == flingToken then
            stopFling(true)
            setStatus("Side Fling selesai; kembali ke posisi awal")
        end
    end)
end

