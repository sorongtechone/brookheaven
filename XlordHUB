    teleport.Size = UDim2.fromOffset(halfW, 34)
    fling.Position = UDim2.fromOffset(10 + halfW + 6, row1Y)
    fling.Size = UDim2.fromOffset(halfW, 34)

    -- Baris 2: TARIK | LIHAT (2 kolom, lebih tipis)
