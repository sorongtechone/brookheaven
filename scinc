local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
header.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.Touch or
       inp.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragInput = inp
        dragStart = inp.Position
        startPos = main.Position
        inp.Changed:Connect(function()
            if inp.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
local moveConn = UIS.InputChanged:Connect(function(inp)
    if not dragging or not dragStart then return end
    if dragInput.UserInputType == Enum.UserInputType.Touch then
        if inp ~= dragInput then return end
    elseif inp.UserInputType ~= Enum.UserInputType.MouseMovement then
        return
    end
    local delta = inp.Position - dragStart
    main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end)
gui.Destroying:Connect(function()
    alive = false
    if moveConn then moveConn:Disconnect() end
end)
