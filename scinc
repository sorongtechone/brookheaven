    for _, row in ipairs(rows) do row:Destroy() end
    rows, records, selected = {}, {}, nil
    count = 0
    detailText.Text = "Belum ada request."
    detailsFrame.CanvasSize = UDim2.fromOffset(0, 0)
    status.Text = "Log dibersihkan"
end)

run.MouseButton1Click:Connect(function()
    if running then return end
    if type(nativeLoadstring) ~= "function" or type(nativeSetfenv) ~= "function" then
        status.Text = "loadstring/setfenv tidak didukung Delta"
        return
    end
    local source = input.Text
    if source:match("^%s*$") then
        status.Text = "Masukkan script Lua dulu"
        return
    end
    local chunk, err = nativeLoadstring(source)
    if not chunk then
        status.Text = "Syntax error: " .. tostring(err):sub(1, 70)
        return
    end
    local env = createEnvironment()
    local ok, setErr = pcall(nativeSetfenv, chunk, env)
    if not ok then
        status.Text = "Env error: " .. tostring(setErr):sub(1, 70)
        return
    end
    running = true
    run.Text = "RUNNING..."
    status.Text = "Running | Request capture active"
    task.spawn(function()
        local worked, result = pcall(chunk)
        running = false
        if alive then
            run.Text = "RUN + CAPTURE"
            if worked then
                status.Text = "Selesai | " .. count .. " request(s)"
            else
                status.Text = "Script error: " .. tostring(result):sub(1, 75)
                warn("[XLORD Inspector] " .. tostring(result))
            end
        end
    end)
end)

